# Payment gateway configuration for wallet top-ups (JazzCash / Easypaisa).
#
# The Firebase CLI deploys `.env` / `.env.velocity-fe379` from this directory
# as function environment variables. In CI these lines come from the
# PAYMENTS_GATEWAY_ENV GitHub Actions secret (see deploy-functions.yml); for a
# manual `firebase deploy` copy this file to `.env.velocity-fe379` and fill it
# in. NEVER commit a filled-in copy — only this .example is tracked.
#
# A provider becomes available in the app as soon as its credentials are
# non-empty; with none set, the wallet runs on the mock provider (dev only).

# ── JazzCash (merchant portal → integration settings) ────────────────────────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# sandbox | live
JAZZCASH_ENV=sandbox

# ── Easypaisa (Easypay merchant portal) ──────────────────────────────────────
EASYPAISA_STORE_ID=
# Optional: enables the AES request hash on checkout.
EASYPAISA_HASH_KEY=
# Optional but strongly recommended for production: enables server-to-server
# payment confirmation before the wallet is credited.
EASYPAISA_INQUIRE_USERNAME=
EASYPAISA_INQUIRE_PASSWORD=
# sandbox | live
EASYPAISA_ENV=sandbox

# ── Commission settlement — AI screenshot verification ───────────────────────
# Anthropic API key for verifying driver commission payment screenshots
# (submitCommissionSettlement). When empty, screenshots skip AI and go straight
# to the admin review queue — the feature still works, just without auto-unlock.
ANTHROPIC_API_KEY=

# ── General ──────────────────────────────────────────────────────────────────
# Default provider when the app doesn't pick one: jazzcash | easypaisa | mock
PAYMENTS_PROVIDER=
# Override the public base URL for the checkout page + gateway callbacks.
# Defaults to https://asia-south1-<project>.cloudfunctions.net
PAYMENTS_BASE_URL=
