# Payment gateway configuration for wallet top-ups (JazzCash / Easypaisa).
#
# The Firebase CLI deploys `.env` / `.env.velocity-fe379` from this directory
# as function environment variables. In CI these lines come from the
# PAYMENTS_GATEWAY_ENV GitHub Actions secret (see deploy-functions.yml); for a
# manual `firebase deploy` copy this file to `.env.velocity-fe379` and fill it
# in. NEVER commit a filled-in copy — only this .example is tracked.
#
# A provider becomes available in the app as soon as its credentials are
# non-empty; with none set, the wallet runs on the mock provider (dev only).

# ── PayFast by APPS — the single-contract aggregator (RECOMMENDED) ───────────
# One merchant account that fronts cards, JazzCash, Easypaisa, HBL Konnect and
# bank transfer, so the app shows a full method picker without onboarding each
# rail separately. Apply at https://getstarted.apps.net.pk/signup — PayFast
# accepts individuals and unregistered businesses, not just SECP companies.
#
# ⚠️ Before the first live rupee, confirm three things in providers.ts against
# the integration pack that arrives with your merchant account: the access-token
# endpoint path, the SIGNATURE formula, and the production base URL. The adapter
# was written from PayFast's public summaries, not the IP-gated official docs.
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
# Shown to the payer on the gateway page; also part of the signature.
PAYFAST_MERCHANT_NAME=Velocity
# sandbox | live
PAYFAST_ENV=sandbox
# Gateway host. Sandbox defaults to https://ipguat.apps.net.pk; there is NO
# default for live, so `isConfigured()` fails closed until you set the
# production host from your merchant pack rather than silently posting real
# money at the sandbox.
PAYFAST_BASE_URL=

# ── JazzCash (merchant portal → integration settings) ────────────────────────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# sandbox | live
JAZZCASH_ENV=sandbox

# ── Easypaisa (Easypay merchant portal) ──────────────────────────────────────
EASYPAISA_STORE_ID=
# Optional: enables the AES request hash on checkout.
EASYPAISA_HASH_KEY=
# Optional but strongly recommended for production: enables server-to-server
# payment confirmation before the wallet is credited.
EASYPAISA_INQUIRE_USERNAME=
EASYPAISA_INQUIRE_PASSWORD=
# sandbox | live
EASYPAISA_ENV=sandbox

# ── Google Maps — server-side routing AND address search ─────────────────────
# Used by:
#   • en-route pickups (trips/enRoute) — the road a driver is actually on, so
#     the corridor riders are matched against is one WE computed rather than one
#     the driver's phone told us about;
#   • the maps proxy (maps/index.ts) — address autocomplete, place details,
#     geocoding and the route line the app draws.
#
# This MUST be a separate key from the Android one in the mobile app. That key is
# restricted to the app's package name + signing certificate (it ships inside the
# APK, so it has to be), and a Cloud Function has neither — Google will reject it.
#
# The same restriction is also why the APP cannot call Places/Routes over REST:
# an Android key restriction is proven by the NATIVE SDK attaching the package
# name and certificate, and a fetch() from JS attaches neither, so Google answers
# PERMISSION_DENIED "Requests from this Android client application <empty> are
# blocked". Hence the proxy — the app now holds no key that can spend money.
#
# To create it — console.cloud.google.com, project velocity-fe379:
#   1. APIs & Services → Library → enable "Routes API" AND "Places API (New)".
#   2. APIs & Services → Credentials → Create credentials → API key.
#   3. Name it "Velocity backend — Routes + Places (server)".
#   4. Application restrictions: NONE. A Cloud Function has no fixed egress IP
#      unless you attach a VPC connector with Cloud NAT, so IP restriction will
#      lock you out. The key is safe because it never leaves the server.
#   5. API restrictions: RESTRICT to "Routes API" + "Places API (New)" and
#      nothing else. This is the restriction that matters — a leaked key can
#      then only draw routes and search addresses.
#   6. Set quota caps on both APIs so a leak cannot run up a bill.
#
# Leave empty and address search returns "not configured" rather than failing,
# and the map falls back to a straight line.
#
# In CI this one does NOT come from the PAYMENTS_GATEWAY_ENV block — it has its
# own GitHub Actions secret, also called GOOGLE_MAPS_SERVER_KEY, so it can be
# rotated on its own without reconstructing a block of credentials nobody can
# read back out of GitHub. Set it here only for a manual `firebase deploy`.
#
# Leave empty and en-route pickups keep working: the backend falls back to the
# validated client polyline, exactly as it did before this key existed.
GOOGLE_MAPS_SERVER_KEY=

# ── Commission settlement — AI screenshot verification ───────────────────────
# Anthropic API key for verifying driver commission payment screenshots
# (submitCommissionSettlement). When empty, screenshots skip AI and go straight
# to the admin review queue — the feature still works, just without auto-unlock.
ANTHROPIC_API_KEY=

# ── General ──────────────────────────────────────────────────────────────────
# Default provider when the app doesn't pick one:
#   payfast | jazzcash | easypaisa | mock
PAYMENTS_PROVIDER=
# Override the public base URL for the checkout page + gateway callbacks.
# Defaults to https://asia-south1-<project>.cloudfunctions.net
PAYMENTS_BASE_URL=

# ── Social desk — connected accounts and the daily AI content pipeline ───────
#
# Both of these have their own GitHub Actions secrets (never the
# PAYMENTS_GATEWAY_ENV block), so either can be rotated on its own. Set them
# here only for a manual `firebase deploy`.

# 32-byte key that encrypts the stored Facebook/Instagram/YouTube/TikTok access
# tokens at rest. Generate one with:  openssl rand -base64 32
#
# This is the one key in the backend that fails CLOSED rather than degrading:
# with no key, accounts cannot be connected and nothing publishes. Storing
# publishing credentials in the clear is not an acceptable fallback.
#
# ⚠️ Rotating it makes every already-stored token unreadable — reconnect each
# account afterwards.
SOCIAL_TOKEN_KEY=
