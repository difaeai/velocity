rules_version = '2';

// ============================================================================
//  Velocity — Firestore Security Rules
// ----------------------------------------------------------------------------
//  Security model (see docs/SECURITY.md):
//   * Default DENY. Nothing is accessible unless a rule below explicitly allows.
//   * Authentication is REQUIRED for every read and write.
//   * Roles are carried in custom claims (request.auth.token.role), which are
//     ONLY settable by the backend (Cloud Functions via the Admin SDK).
//   * Money, verification status, ratings, trip state and counters are
//     SERVER-AUTHORITATIVE: clients can never write them directly. Those paths
//     are written exclusively by Cloud Functions, which bypass these rules.
//   * Where clients may write at all, writes are restricted to an explicit
//     whitelist of fields so privileged fields cannot be smuggled in.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : '';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isDriver() {
      return role() == 'driver';
    }

    // True when the incoming write only touches the supplied field names.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Gender is answered once. Every shared-ride gender rule (women-only cars,
    // who may join whom) reads it, so a profile that could change it at will
    // would let anyone into a women-only car. Admins correct real mistakes.
    function genderUnchangedOrFirstAnswer() {
      return resource.data.get('gender', 'unspecified') == 'unspecified'
             || request.resource.data.get('gender', 'unspecified') == resource.data.get('gender', 'unspecified');
    }

    // ----- users/{uid} -----------------------------------------------------
    // Profile docs. Created by the onUserCreate backend trigger. The owner may
    // edit only safe profile fields; role / verification / wallet live elsewhere
    // or are server-only.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      // create only happens during the race before onUserCreate trigger fires
      allow create: if isOwner(userId);
      // update: owner may only touch safe profile fields — role is server-only.
      // mixedRideOk is the pool-ride opposite-gender opt-in, and
      // sharedRideGenderPref the explicit answer behind it ('same_gender' /
      // 'any_gender'). Both are written together by the home-screen selector —
      // see apps/mobile/src/hooks/genderPref.ts. mixedRideOk stays the flag
      // every gate reads; the pref only tells "chose same-gender" apart from
      // "never asked", so it must be writable alongside it.
      allow update: if isOwner(userId)
                    && onlyChanges(['displayName', 'name', 'gender', 'dob', 'age',
                                    'profileComplete', 'photoURL', 'lastActive', 'updatedAt',
                                    'mixedRideOk', 'sharedRideGenderPref'])
                    && genderUnchangedOrFirstAnswer();
      allow update, delete: if isAdmin();

      // Saved places (home / work / favourites) — owner-managed bookmarks.
      match /savedPlaces/{placeId} {
        allow read, write: if isOwner(userId);
      }

      // Daily routes — owner-managed commutes that trigger public-pool alerts.
      // The match runs server-side via a collection-group scan (admin SDK), so
      // no group-scope read exception is needed here.
      match /dailyRoutes/{routeId} {
        allow read, write: if isOwner(userId);
      }

      // Safety settings. Today that is one document, `emergencyContacts`: the
      // at-most-five people an SOS goes to (see apps/mobile/src/lib/sos.ts).
      //
      // Owner-only in BOTH directions, and that is the point — these are other
      // people's phone numbers, given to us so the owner can reach them in an
      // emergency and for nothing else. No driver, no rider and no query in
      // the product has any business reading them.
      //
      // The cap is enforced here rather than only in the app, which is the
      // reason the list is one document holding an array instead of a
      // subcollection: a rule can count an array, and cannot count documents.
      match /safety/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && settingId == 'emergencyContacts'
                              && request.resource.data.contacts is list
                              && request.resource.data.contacts.size() <= 5;
      }
    }

    // ----- usernames/{slug} -------------------------------------------------
    // The uniqueness registry: one document per lowercased username, holding
    // the uid that claimed it. Written only by `claimUsername`, which takes it
    // in a transaction — a client that could write here could steal a name out
    // from under the person typing it.
    //
    // `get` is open to signed-in clients and `list` is not, on purpose. The
    // app has to say "that one is taken" while you type, and a callable per
    // keystroke is a cold start per keystroke; a single-document get answers
    // it for one read. Refusing `list` is what keeps that from also being a
    // way to download everybody's username.
    match /usernames/{slug} {
      allow get:   if isSignedIn();
      allow list:  if false;
      allow write: if false;
    }

    // ----- fleets/{uid} -----------------------------------------------------
    // A rider's personal fleet: their saved route, who is in it, the requests
    // waiting on them and the ride asks sent to them.
    //
    // Closed in BOTH directions, which is unusual here and deliberate. Reading
    // a fleet means reading other people's names and photos out of
    // `users/{uid}`, and those are owner-only two rules up — a client-readable
    // fleet document would be a list of uids this rider could then do nothing
    // with, and a client-WRITABLE one would let anyone add themselves to a
    // stranger's circle and start pushing ride invitations at them.
    // `getMyFleet` is the only way in; see backend/functions/src/fleet.
    match /fleets/{userId}/{document=**} {
      allow read, write: if false;
    }

    // ----- fleetAsks/{askId} ------------------------------------------------
    // "I'm going to Gulberg now — coming?", and who has said yes. Server-only
    // for the same reason: the accepted list is what decides who gets seated
    // on the car, so a client that could write to it could put itself in
    // somebody else's booking.
    match /fleetAsks/{askId} {
      allow read, write: if false;
    }

    // ----- cnicVerifications/{uid} -----------------------------------------
    // The admin review queue for passenger CNIC verification (the identity gate
    // in front of couriers). Written only by the submitCnicVerification /
    // adminReviewCnicVerification functions; the owner may read their own
    // submission back, admins read the whole queue. The authoritative copy the
    // app gates on lives on users/{uid}.cnicVerification, which is outside the
    // owner-writable whitelist above — so status is server-only either way.
    match /cnicVerifications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- driverFaceScans/{scanId} ----------------------------------------
    // One live face scan: the poses the SERVER chose, and what the model made
    // of the frames that came back. Written only by startFaceScan /
    // submitFaceScan.
    //
    // NO CLIENT READ, not even by the owner — and that is the whole point. The
    // poses are the secret: an applicant who could read this document before
    // submitting would know what they were about to be asked and could hold up
    // a prepared photograph for each one, which is exactly the attack the scan
    // exists to stop. The applicant learns the poses from the callable's return
    // value, one scan at a time, and the verdict reaches them on their own
    // driver document (drivers/{uid}.faceScan) instead.
    match /driverFaceScans/{scanId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- driverFaceEnrolment/{uid} ---------------------------------------
    // The 128 numbers a driver's face is, measured from the frame that was
    // proven against their CNIC and their licence, and the reference every
    // daily face check is compared with.
    //
    // NO CLIENT ACCESS AT ALL — not the owner, not an admin. It is biometric
    // data that nobody has any use for on a handset or in a browser: a client
    // that could read it could grind candidate faces against it offline until
    // one fitted, which is precisely the substitution the daily check exists to
    // catch. Written and read only by drivers/faceScan.ts through the Admin
    // SDK. What a human needs to see — passed, undecided, not the driver — is
    // on the driver document as `faceCheckIn`.
    match /driverFaceEnrolment/{driverId} {
      allow read, write: if false;
    }

    // ----- driverVerificationJobs/{jobId} -----------------------------------
    // The queue the verification engine works through — one document per
    // submission, written by submitDriverOnboarding and consumed by the
    // processDriverVerification trigger. A client that could create one could
    // make us re-run a paid vision pass on any driver at will, so creation is
    // server-only; a client that could read one would see another applicant's
    // risk score. Admins read it as an audit trail of every attempt.
    match /driverVerificationJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- drivers/{uid} ---------------------------------------------------
    // Driver operational doc. Verification, rating, earnings and commission are
    // server-only. The driver may update ONLY presence/location fields so GPS
    // pings don't require a function call on every update.
    match /drivers/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow create: if false;

      // ── The car photo gate ────────────────────────────────────────────────
      // A driver may only go online in a car they have just photographed. The
      // check is written by the confirmVehiclePhoto callable (drivers/vehicles.ts)
      // and cleared whenever they switch cars, so it answers "is the car about
      // to arrive the car we think it is?" rather than "did their papers pass
      // review last spring".
      //
      // It lives HERE and not only in the app because `online` is one of the
      // very few fields a client writes directly: a patched build could
      // otherwise flip it and start taking rides in an unphotographed car.

      // 'primary' is the id drivers/vehicles.ts seeds the onboarding car under,
      // and the fallback for a driver who has never opened the car screens — the
      // backend guard and the app both default to the same string, and a
      // disagreement would lock an existing driver out of going online.
      function activeVehicle(driver) {
        return driver.get('activeVehicleId', 'primary');
      }
      // Every field is tested for presence before it is read: a half-written
      // check reads as no check, never as a pass. confirmVehiclePhoto always
      // writes all three together, so a live check always has them.
      function carPhotoIsLive() {
        return 'vehicleCheck' in resource.data
               && 'status' in resource.data.vehicleCheck
               && 'vehicleId' in resource.data.vehicleCheck
               && 'confirmedAt' in resource.data.vehicleCheck
               && resource.data.vehicleCheck.status != 'rejected'
               && resource.data.vehicleCheck.vehicleId == activeVehicle(resource.data)
               && resource.data.vehicleCheck.confirmedAt > request.time - duration.value(30, 'd');
      }
      // Only the TRANSITION is gated. A driver already online keeps beaconing
      // their position even if the 30 days lapse mid-shift — silently killing
      // location updates on a driver carrying a passenger would be far worse
      // than one stale check — and they are stopped at the next go-online.
      function goingOnline() {
        return request.resource.data.get('online', false) == true
               && resource.data.get('online', false) != true;
      }

      // ── The daily face check ──────────────────────────────────────────────
      // Papers prove who an account belongs to on the day it is approved. They
      // prove nothing about who picks the phone up four months later, and an
      // account quietly being driven by somebody else is exactly the fraud this
      // catches: the first time a driver opens the app each day they look into
      // the camera, and the frames are compared with the face enrolled when
      // they were approved.
      //
      // `required` is stamped onto the driver document by the server — on
      // approval, and nightly by the expiry sweep — from the admin switch.
      // Absent means no, which is what an older app build must get: it has no
      // camera screen to satisfy this with.
      //
      // DELIBERATELY LOOSER THAN THE SERVER. The real rule is a Pakistan-day
      // comparison (backend/functions/src/domain/faceCheckIn.ts); rules cannot
      // do calendar arithmetic, so this asks only that a check passed within
      // the last 24 hours. The two can therefore disagree for a few hours after
      // midnight — always in the direction of letting a driver go online whom
      // the server will then refuse work, never the reverse. This rule can
      // never lock a driver out while the server believes they are clear.
      function faceCheckedRecently() {
        return resource.data.get('faceCheckIn', {}).get('required', false) != true
               || (resource.data.faceCheckIn.get('passedAt', null) != null
                   && resource.data.faceCheckIn.passedAt > request.time - duration.value(24, 'h'));
      }

      // `appActiveAt` is the driver app's foreground heartbeat, written every
      // couple of minutes while any driver screen is on screen. The backend
      // reads it to tell "offline" apart from "app closed" before spending a
      // paid WhatsApp message on somebody who is looking at the app already.
      // Self-reported and therefore only ever used to send LESS: a driver who
      // lied about it would only suppress their own alerts.
      // NOTE on `geohash`: deliberately NOT writable here. The cell that
      // lib/nearbyDrivers.ts queries on must be in geofire's format at full
      // precision — "long stored, short queried" — and the app has no
      // geofire-common. Two geohash implementations drifting apart would make
      // drivers invisible rather than merely stale, which is far worse than the
      // problem it would solve, so the format stays owned by one place: the
      // server. The driver app calls `stampDriverCell` when it goes online and
      // drivers/geohashSweeper.ts keeps it current after that.
      allow update: if isOwner(driverId)
                    && isDriver()
                    // `rideMode` is Solo|Sharing, written when the driver flips
                    // the selector on their home screen. The pool offer ladder
                    // reads it to skip drivers who have chosen solo work. Safe
                    // for the handset to own: the only thing a driver can do by
                    // lying about it is take themselves OUT of shared-ride
                    // offers, and absent already means "available".
                    && onlyChanges(['online', 'lastLocation', 'heading', 'lastSeenAt',
                                    'appActiveAt', 'rideMode',
                                    'poolPickupRadiusM', 'poolDropoffRadiusM'])
                    && (!goingOnline() || (carPhotoIsLive() && faceCheckedRecently()));
      allow update: if isAdmin();
      allow delete: if false;

      // ── drivers/{uid}/vehicles/{vehicleId} ────────────────────────────────
      // Every car this driver may drive, one document each, with its own review
      // state. Written only by the callables in drivers/vehicles.ts — a client
      // that could write here could approve its own unvetted car.
      match /vehicles/{vehicleId} {
        allow read: if isOwner(driverId) || isAdmin();
        allow write: if false;
      }

      // ── drivers/{uid}/dailyTargets/{YYYY-MM-DD} ───────────────────────────
      // One document per driver-day: rides done, pool rides done, fares taken,
      // and whether the day hit its target and went commission-free. The driver
      // streams today's document so the progress card moves the moment a ride
      // completes — which is why it is readable here rather than behind a
      // callable, and why nothing but the settlement transaction may write it.
      // A driver who could write this could make their own day free.
      match /dailyTargets/{day} {
        allow read: if isOwner(driverId) || isAdmin();
        allow write: if false;
      }

      // ── drivers/{uid}/commissionCredits/{id} ──────────────────────────────
      // The driver's credit statement: every target bonus granted, every rupee
      // of it spent on a commission cycle, every admin adjustment. Money, so
      // read-only to its owner and written only by the backend.
      match /commissionCredits/{creditId} {
        allow read: if isOwner(driverId) || isAdmin();
        allow write: if false;
      }

      // ── drivers/{uid}/commissionPayments/{id} ─────────────────────────────
      // Settled cycles. Already written by three backend paths; the driver had
      // no way to read their own payment history until now.
      match /commissionPayments/{paymentId} {
        allow read: if isOwner(driverId) || isAdmin();
        allow write: if false;
      }
    }

    // ----- trips/{tripId} --------------------------------------------------
    // Fully server-authoritative. Trips are created and mutated only by Cloud
    // Functions. Clients READ if they are a participant; they ACT via callables.
    match /trips/{tripId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.passengerId == uid())
                  || (isSignedIn() && resource.data.driverId == uid())
                  // Pool riders who joined via a share link track the trip live.
                  || (isSignedIn()
                      && 'poolMembers' in resource.data
                      && uid() in resource.data.poolMembers);
      // Everything that matters about a trip — status, fare, who is driving —
      // is server-only and stays that way.
      //
      // The one exception is the driver's own position while they are the
      // assigned driver. The passenger cannot read `drivers/{id}` (that document
      // is the driver's alone), so without a copy on the trip there is no way to
      // show "4 min away" — the rider is left watching a static map wondering if
      // anyone is coming. Relaying it through a callable would mean a function
      // invocation every few seconds for every driver on the road, which is a
      // lot of money to spend on a coordinate.
      //
      // Scoped as tightly as it can be: only the assigned driver, only while the
      // ride is live, and only these two fields — so it cannot be used to touch
      // a fare, a status, or anyone else's trip.
      allow update: if isSignedIn()
                    && resource.data.driverId == uid()
                    && resource.data.status in ['matched', 'arriving', 'arrived', 'in_progress']
                    && onlyChanges(['driverLocation', 'driverLocationAt']);
      allow create, delete: if false;

      // Bids placed by drivers (created server-side via placeBid). The passenger
      // who owns the parent trip and the bidding driver may read.
      match /bids/{bidId} {
        allow read: if isAdmin()
                    || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == uid())
                    || (isSignedIn() && resource.data.driverId == uid());
        allow write: if false;
      }

      // In-ride chat between everyone sharing the car.
      //
      // Pool riders are readers too. sendTripMessage has always delivered the
      // message to them — its participant set is passenger + driver + poolMembers
      // — but the read rule stopped at the first two, so a rider who joined a
      // pool by link got the push and then an empty conversation. The parent trip
      // document already grants them a read on exactly this condition.
      match /chat/{msgId} {
        allow read: if isAdmin()
                    || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == uid())
                    || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == uid())
                    || (isSignedIn()
                        && 'poolMembers' in get(/databases/$(database)/documents/trips/$(tripId)).data
                        && uid() in get(/databases/$(database)/documents/trips/$(tripId)).data.poolMembers);
        allow create: if isSignedIn()
                      && (
                        get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == uid()
                        || get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == uid()
                      )
                      && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'sentAt'])
                      && request.resource.data.senderId == uid()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      // Riders asking for one of this pool's free seats. Written only by
      // joinPoolTrip / driverRespondToPoolJoin / coRiderObjectToPoolJoin
      // (Admin SDK). The rider watches their own request go from pending to
      // accepted or rejected.
      //
      // Read by the driver, AND by everyone already in the car. It used to be
      // the driver alone, which was right while they were the only person who
      // could act on it. They are not any more: a ride with no driver yet sends
      // vetting requests to the host, and any co-rider may refuse one outright
      // (see coRiderObjectToPoolJoin). People cannot answer a request they are
      // not allowed to look at, and this has to stay in step with the same
      // decision in `getPoolJoinRequests` — the callable grants exactly this.
      match /joinRequests/{riderId} {
        allow read: if isAdmin()
                    || (isSignedIn() && riderId == uid())
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == uid())
                    || (isSignedIn()
                        && uid() in get(/databases/$(database)/documents/trips/$(tripId)).data.poolMembers);
        allow write: if false;
      }

      // Who was picked up along the way, and when. Everyone in the car may read
      // it — knowing exactly who got in is the point of the feature, not a
      // detail of it. Written only by acceptEnRouteRider (Admin SDK).
      match /enRouteLog/{entryId} {
        allow read: if isAdmin()
                    || (isSignedIn()
                        && uid() in get(/databases/$(database)/documents/trips/$(tripId)).data.poolMembers)
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == uid());
        allow write: if false;
      }
    }

    // ----- driverRoutes/{driverId} -----------------------------------------
    // A driver's declared route ("I'm heading home") — the corridor that
    // getEnRouteMatches searches for riders on their way. Only the driver
    // themselves reads it; only the backend writes it, so a driver cannot widen
    // their own corridor to sweep up rides that are not on their route.
    match /driverRoutes/{driverId} {
      allow read: if isAdmin() || (isSignedIn() && driverId == uid());
      allow write: if false;
    }

    // ----- poolRides/{rideId} ----------------------------------------------
    // The driver posts the offer straight from the app; after that, seats,
    // status, the gender tally and the fare riders were quoted change ONLY
    // through the joinPoolRide / driverAcceptPoolBatch / startPoolBoarding /
    // completePoolRide CFs (Admin SDK). The driver app never edits the doc.
    // A driver who could would lower `perSeatFare` — or un-mark the riders —
    // just before ending the ride, and owe no commission on cash already taken.
    match /poolRides/{rideId} {
      // Riders choose women-only rides and trust the stars by what this doc
      // says, so both are the driver profile's (server-owned), copied the way
      // driver/pool-ride-offer.tsx copies them — missing means 'unspecified' / 5.0.
      function copiesDriverProfile(ride) {
        let p = get(/databases/$(database)/documents/drivers/$(uid())).data;
        return ride.driverGender == (p.get('gender', null) == null ? 'unspecified' : p.gender)
               && ride.driverRating == (p.get('rating', null) == null ? 5.0 : p.rating);
      }

      allow read: if isSignedIn();
      allow create: if isDriver() && request.resource.data.driverId == uid()
                    && request.resource.data.status == 'open'
                    && request.resource.data.takenSeats == 0
                    && request.resource.data.maleSeats == 0
                    && request.resource.data.femaleSeats == 0
                    && copiesDriverProfile(request.resource.data);
      allow update, delete: if false;

      // Passenger seat docs are created exclusively by the joinPoolRide CF —
      // a direct client create would bypass seat limits and gender rules.
      //
      // Read by the rider themselves and by THIS ride's driver. Each seat
      // carries the rider's phone and exact pickup point; `isDriver()` here
      // used to hand every rider of every pool to every driver in the country.
      match /passengers/{passengerId} {
        allow read: if isAdmin()
                    || (isSignedIn()
                        && (uid() == passengerId
                            || get(/databases/$(database)/documents/poolRides/$(rideId)).data.driverId == uid()));
        allow update: if isAdmin();
        allow create, delete: if false;
      }

      // Queued join requests for mixed (1M+1F) pools. Written only by the
      // joinPoolRide / driverAcceptPoolBatch CFs. The requester sees their own
      // request; the ride's driver sees the queue to accept same-gender pairs.
      match /joinRequests/{userId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || get(/databases/$(database)/documents/poolRides/$(rideId)).data.driverId == uid()
          || isAdmin()
        );
        allow write: if false;
      }

      // Group chat for the pool ride (driver + all passengers).
      //
      // Membership is checked on BOTH sides, the way trips/{tripId}/chat does
      // it. This used to read `allow read: if isSignedIn()` with a create rule
      // that only checked the sender was writing under their own name — which
      // meant any signed-in account could read, and post into, the private
      // conversation of a car full of strangers. The parent `poolRides` doc is
      // itself readable by every signed-in user (it is a browsable offer), so
      // the ride ids needed to do it were one query away; there was nothing to
      // guess.
      //
      // A member is the ride's own driver, or somebody holding a seat doc —
      // `passengers/{uid}` is written only by the joinPoolRide CF, so it is the
      // authoritative answer to "is this person in this car".
      function inThisPool() {
        return isSignedIn() && (
          get(/databases/$(database)/documents/poolRides/$(rideId)).data.driverId == uid()
          || exists(/databases/$(database)/documents/poolRides/$(rideId)/passengers/$(uid()))
        );
      }

      match /chat/{msgId} {
        allow read: if isAdmin() || inThisPool();
        allow create: if inThisPool()
                      && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'sentAt'])
                      && request.resource.data.senderId == uid()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // ----- ratings/{ratingId} ----------------------------------------------
    // Written exclusively by the submitRating Cloud Function.
    match /ratings/{ratingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.raterId == uid());
      allow write: if false;
    }

    // ----- wallets/{uid} ---------------------------------------------------
    // Balances and ledger are server-only writes. Owner and admin may read.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;

      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ----- safetyEvents/{id} ----------------------------------------------
    // SOS / route-deviation records. Created server-side. The reporter and any
    // admin may read; nobody writes directly.
    match /safetyEvents/{eventId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.reportedBy == uid());
      allow write: if false;
    }

    // ----- system/{doc} ----------------------------------------------------
    // Platform counters (revenue, commissions, payouts). Admin-readable for the
    // dashboard; never client-writable.
    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false;

      // One document under here carries a credential rather than a counter:
      // system/socialMetaApp holds the Meta App ID (public, readable above)
      // and this subcollection holds the App Secret, sealed. Subcollections do
      // not inherit the read above, and this rule is what makes that explicit
      // rather than accidental.
      match /secret/{secretId} {
        allow read, write: if false;
      }
    }

    // ----- adminConfig/{doc} -----------------------------------------------
    // Console-only configuration, admin-readable AND admin-writable. Distinct
    // from config/{doc}, which every signed-in app user can read: the one doc
    // here (platformCosts) is what Velocity pays its vendors, and no passenger
    // or driver has any business seeing the company's bill.
    match /adminConfig/{docId} {
      allow read, write: if isAdmin();
    }

    // ----- auditLogs/{id} --------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- qaLogs/{YYYY-MM-DD} ---------------------------------------------
    // The testing log: one document per Pakistan day, holding the counters and
    // the agent's last run, with one entry per distinct problem beneath it.
    //
    // Writes belong to the backend alone. The app does not write its own
    // failure reports — it calls reportFeatureCheck, which rate-limits them,
    // caps their length and refuses to let a wrong phone clock file a report on
    // tomorrow's day. A client that could write here directly could also bury
    // a real bug under four hundred invented ones.
    //
    // The one thing an admin may change is the triage: status, and a note. The
    // narrative, the evidence and the prompt are what the engine observed, and
    // an account of a bug that somebody could quietly edit is not evidence of
    // anything. Hence the affectedKeys fence rather than a blanket update.
    match /qaLogs/{day} {
      allow read: if isAdmin();
      allow write: if false;

      match /entries/{signature} {
        allow read: if isAdmin();
        allow create, delete: if false;
        allow update: if isAdmin()
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status', 'adminNote', 'triagedAt', 'triagedBy'])
                      && request.resource.data.status in ['open', 'fixed', 'ignored'];
      }
    }

    // ----- analyticsDaily/{YYYY-MM-DD} -------------------------------------
    // One rolled-up day of platform activity, written by adminGetAnalytics the
    // first time anyone asks for that day. Feeds the dashboard charts.
    match /analyticsDaily/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialAccounts/{platform} ---------------------------------------
    // The connected Facebook / Instagram / YouTube / TikTok accounts. The
    // profile half is admin-readable so the console can show live status.
    match /socialAccounts/{platform} {
      allow read: if isAdmin();
      allow write: if false;

      // The access tokens, sealed with SOCIAL_TOKEN_KEY. Closed to every
      // client including admins: a page token is a password that can post to
      // the whole audience, and only Cloud Functions has any business holding
      // one. Subcollections do not inherit the rule above, so this is the rule
      // that actually keeps them shut.
      match /secret/{docId} {
        allow read, write: if false;
      }
    }

    // ----- socialOAuthStates/{state} ---------------------------------------
    // The few minutes between "Connect Instagram" being pressed and the Page
    // being chosen. The document holds the Page access tokens Facebook just
    // handed back, sealed — so unlike every other admin-readable record here,
    // this one is shut to the console as well. Nothing client-side ever needs
    // to read it: the state string travels through the OAuth redirect, and the
    // callables look it up with the Admin SDK.
    match /socialOAuthStates/{state} {
      allow read, write: if false;
    }

    // ----- socialEmployees/{id} --------------------------------------------
    // The people hired onto the social desk: name, job, personal direction and
    // what they have worked on. Admin-readable so the console can render the
    // roster live; written only through the hire/update/fire callables, because
    // who works here decides what gets published in Velocity name.
    match /socialEmployees/{employeeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialPosts/{YYYY-MM-DD-format} ---------------------------------
    // One piece the crew made: the plan, script, media, per-network results and
    // the round-by-round feedback an admin gave on it.
    match /socialPosts/{postId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialResearch/{YYYY-MM-DD} -------------------------------------
    // The writer's market read for one day, with the pages it came from. Cached
    // so a second run the same morning does not pay for the search twice.
    match /socialResearch/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialPlans/{YYYY-MM} -------------------------------------------
    // The month's content strategy: goal, pillars, weekly themes, a slot per
    // day, paid campaigns and sales moves. Written only by the backend.
    match /socialPlans/{month} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialInsights/{latest|profile} ----------------------------------
    // How our own posts actually did, ranked against this account's own median,
    // and the twelve-point score of the profile they all land on. Read from the
    // networks by the backend; the console only reads it back.
    match /socialInsights/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialAds/{campaignId} ------------------------------------------
    // Every Meta campaign in the connected ad account, as the ads desk last
    // read and judged it. Written only by the backend: a campaign is money, and
    // every change to one goes through a callable that holds it to the owner's
    // daily limit. The ad token itself sits under system/socialAds/secret,
    // which the system rule above already shuts to every client.
    match /socialAds/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialComments/{platform_commentId} ------------------------------
    // What people said under our own posts, and the reply the manager drafted.
    // Written only by the backend: a reply that leaves this collection is
    // Velocity speaking in public, so it goes out through a callable that
    // checks admin, never through a client write.
    match /socialComments/{commentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- platformLedger/{id} ----------------------------------------------
    // Realized platform revenue (ride commissions, subscription payments).
    // Written only by the backend inside money transactions; admin-readable.
    match /platformLedger/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- config/{doc} ----------------------------------------------------
    // Public app configuration (ride types, base fares, service areas). Any
    // authenticated user may read; only admins may change it.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ----- marketRates/{cityId} -------------------------------------------
    // What inDrive and Yango charge in this city, as rate cards fitted to real
    // observations. Riders read it so the booking screen can show the
    // comparison without a round trip; only the callables write it, so no
    // client can invent a competitor price for us to undercut.
    match /marketRates/{cityId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- competitorQuoteReports/{id} ------------------------------------
    // Riders telling us what another app quoted them. Written through
    // reportCompetitorQuote (which rate-limits and sanity-checks), read only by
    // the market desk — one rider's report is not for other riders to see.
    match /competitorQuoteReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- marketRuns/{id} ------------------------------------------------
    // What the daily market run did last time it ran: which rate cards it
    // refitted from rider reports, which it confirmed, and which it refused to
    // move and why (fare/marketRefresh.ts). Operational diagnostics for the
    // market desk, written only by the scheduled job.
    match /marketRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- paymentIntents/{id} & payouts/{id} -----------------------------
    // Wallet top-up intents and driver payout requests. Written only by the
    // backend; the owner and admins may read.
    match /paymentIntents/{intentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }
    match /payouts/{payoutId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.driverId == uid());
      allow write: if false;
    }

    // ----- paymentMethods/{id} --------------------------------------------
    // Connected Easypaisa/JazzCash/bank/card instruments. The owner may READ
    // the display data (kind, masked tail, default flag) so the app can render
    // the Payment methods screen live, but never writes: connecting, removing
    // and re-defaulting all go through callables that also talk to the gateway.
    match /paymentMethods/{methodId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    // The setup handshake — readable by its owner so the app can watch a
    // connection complete. Never client-written.
    match /paymentMethodSetups/{setupId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    // ----- payment secrets -------------------------------------------------
    // The gateway tokens themselves: the one thing that can actually move
    // money without the user present. NOBODY reads these from a client, not
    // even the owner and not even an admin — only server code with the Admin
    // SDK, which bypasses rules. Same posture as paymentIntentSecrets.
    match /paymentMethodSecrets/{methodId} {
      allow read, write: if false;
    }
    match /paymentMethodSetupSecrets/{setupId} {
      allow read, write: if false;
    }

    // ----- commissionSettlements/{id} -------------------------------------
    // Manual settlements (bank transfer + AI-verified screenshot): driver
    // commission cycles AND cancellation fees owed by passengers or drivers.
    // Written only by the backend; the payer and admins may read.
    match /commissionSettlements/{settlementId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.driverId == uid())
                  || (isSignedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    // ----- manualTopups/{id} ----------------------------------------------
    // Bank-transfer top-ups and what our OCR engine made of the receipt. The
    // payer reads their own so the app can show "credited" / "being checked";
    // everything on it is written by the backend.
    match /manualTopups/{topupId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    // ----- manualTopupProofs/{sha256} & manualTopupRefs/{refKey} ----------
    // The spent-receipt ledger: one image digest and one bank reference may
    // each be credited exactly once, ever. NOBODY reads these, not even their
    // owner and not even an admin from a client — a client that can read them
    // can enumerate which references are still unspent, which is the one piece
    // of knowledge that makes forging a receipt worth trying. The backend uses
    // the Admin SDK, which these rules do not apply to.
    match /manualTopupProofs/{sha} {
      allow read, write: if false;
    }
    match /manualTopupRefs/{refKey} {
      allow read, write: if false;
    }

    // ----- openRequests/{tripId} ------------------------------------------
    // Public-safe feed of open ride requests, written only by the backend.
    // Approved drivers (driver role) read it to discover work; the full trip
    // document stays private to its participants.
    match /openRequests/{tripId} {
      allow read: if isDriver();
      allow write: if false;
    }

    // ----- travelMatePlans/{planId} ----------------------------------------
    // Any authenticated user can browse plans (needed for the subscription
    // purchase screen). Writes go exclusively through the CF (Admin SDK).
    match /travelMatePlans/{planId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- travelMateSubscriptions/{subId} ---------------------------------
    // A user may read (and list) their own subscriptions.
    // Admin reads all. All writes go through the CF.
    match /travelMateSubscriptions/{subId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    // ----- travelMateProfiles/{uid} ----------------------------------------
    match /travelMateProfiles/{userId} {
      // Owner reads own profile to pre-fill the setup form.
      // Any signed-in user can read profiles to show swipe deck cards.
      allow read: if isSignedIn();
      // Owner writes own profile directly from the setup screen — but only the
      // fields that screen edits. Rating / moderation fields stay server-only.
      // displayNameLower powers people search; createdAt is the "joined" date.
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'displayName', 'displayNameLower', 'age', 'gender',
                          'genderPref', 'bio',
                          'interests', 'photoURL', 'active', 'lastActive', 'createdAt',
                          'location', 'searchRadiusKm',
                          'travelPrefs', 'travelPrefsUpdatedAt']);
      allow update: if isOwner(userId)
                    && onlyChanges(['displayName', 'displayNameLower', 'age', 'gender',
                                    'genderPref', 'bio',
                                    'interests', 'photoURL', 'active', 'lastActive', 'createdAt',
                                    'location', 'searchRadiusKm',
                                    'travelPrefs', 'travelPrefsUpdatedAt'])
                    && genderUnchangedOrFirstAnswer();
      allow delete: if false;
    }

    // ----- travelMatePosts/{postId} ----------------------------------------
    // Community feed posts. Created/liked/commented/deleted ONLY via the
    // community CFs (server keeps the like/comment counters authoritative and
    // handles media upload). Any signed-in user may read the feed.
    match /travelMatePosts/{postId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Post likes + comments live in subcollections of travelMatePosts.
    // Matched with path=** so both direct reads and collection-group queries
    // (profile "Comments" / "Likes" tabs) work. Only the community CFs write.
    // NOTE: these names are only used under travelMatePosts today — keep new
    // collections from being named `comments`/`likes` unless they may be public.
    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /{path=**}/likes/{likeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- travelMateFollows/{followerId_followedId} ------------------------
    // Public follow graph for the community feed. The doc ID MUST encode the
    // real follower (same trick as swipes) so nobody can forge a follow from
    // someone else. Reads are open to signed-in users: follower/following
    // counts and lists are public social data.
    match /travelMateFollows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.followerId == uid()
                    && request.resource.data.followedId is string
                    && request.resource.data.followedId != uid()
                    && followId == uid() + '_' + request.resource.data.followedId;
      allow delete: if isSignedIn() && resource.data.followerId == uid();
      allow update: if false;
    }

    // ----- travelMateBlocks/{blockerId_blockedId} ---------------------------
    // Written only by the blockTravelMateUser / unblockTravelMateUser CFs
    // (blocking also severs follows and closes any open chat server-side).
    // PRIVATE: only the blocker (and admins) may read their own block list —
    // the blocked user must never learn they were blocked.
    match /travelMateBlocks/{blockId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.blockerId == uid());
      allow write: if false;
    }

    // ----- travelMateCommunities/{communityId} ------------------------------
    // City-based community groups. Every community is pinned to a city so
    // members always see where it belongs. Create/join/leave go through the
    // community CFs (membership counters are server-authoritative). Browsable
    // by any signed-in user.
    match /travelMateCommunities/{communityId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- travelMateSwipes/{swipeId} ----------------------------------------
    // swipeId format: {swiperId}_{swipedId}. The doc ID MUST encode the real
    // swiper — otherwise a user could forge someone else's like and then
    // create a "mutual" match below.
    match /travelMateSwipes/{swipeId} {
      allow read: if isSignedIn() && (
        resource.data.swiperId == uid() || resource.data.swipedId == uid()
      );
      allow create: if isSignedIn()
                    && request.resource.data.swiperId == uid()
                    && request.resource.data.swipedId is string
                    && request.resource.data.swipedId != uid()
                    && swipeId == uid() + '_' + request.resource.data.swipedId
                    && request.resource.data.direction in ['like', 'pass'];
      allow update, delete: if false;
    }

    // ----- travelMateMatches/{matchId} -------------------------------------
    // A match doc's `users` array contains exactly two sorted UIDs.
    // Only the two matched users may read the match or its chat.
    // Creation requires a verified MUTUAL like: both swipe docs must exist
    // with direction == 'like' (swipe doc IDs are bound to the swiper above,
    // so neither can be forged).
    match /travelMateMatches/{matchId} {
      allow read: if isSignedIn() && uid() in resource.data.users;
      allow create: if isSignedIn()
                    && uid() in request.resource.data.users
                    && request.resource.data.users.size() == 2
                    && request.resource.data.users[0] != request.resource.data.users[1]
                    && matchId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
                    && get(/databases/$(database)/documents/travelMateSwipes/$(request.resource.data.users[0] + '_' + request.resource.data.users[1])).data.direction == 'like'
                    && get(/databases/$(database)/documents/travelMateSwipes/$(request.resource.data.users[1] + '_' + request.resource.data.users[0])).data.direction == 'like';
      allow update: if false;
      allow delete: if false;

      match /chat/{msgId} {
        allow read: if isSignedIn()
                    && uid() in get(/databases/$(database)/documents/travelMateMatches/$(matchId)).data.users;
        allow create: if isSignedIn()
                      && uid() in get(/databases/$(database)/documents/travelMateMatches/$(matchId)).data.users
                      && request.resource.data.senderId == uid()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      // CF (sendTravelMateMessage) writes here; clients may only read.
      match /messages/{msgId} {
        allow read: if isSignedIn()
                    && uid() in get(/databases/$(database)/documents/travelMateMatches/$(matchId)).data.users;
        allow write: if false;
      }
    }

    // ----- travelMateGroups/{groupId} --------------------------------------
    // Only group members may read their group or its settlement history.
    // All writes go through the CF (Admin SDK).
    match /travelMateGroups/{groupId} {
      allow read: if isSignedIn() && uid() in resource.data.members;
      allow write: if false;

      match /settlements/{tripId} {
        allow read: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/travelMateGroups/$(groupId)).data.members;
        allow write: if false;
      }

      // Joint group chat. CF (sendTravelMateGroupMessage) is the primary
      // writer (it also pushes FCM); a member may create a plain text message
      // directly as a fallback path.
      match /messages/{msgId} {
        allow read: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/travelMateGroups/$(groupId)).data.members;
        allow create: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/travelMateGroups/$(groupId)).data.members
          && request.resource.data.senderId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ----- travelMateSharedRides/{shareId} ----------------------------------
    // Shareable ride links. Resolution + booking go through CFs (which gate on
    // travel-partner status); direct reads are limited to people already on
    // the ride so live co-rider updates work.
    match /travelMateSharedRides/{shareId} {
      allow read: if isSignedIn() && uid() in resource.data.coRiders;
      allow write: if false;
    }

    // ----- travelMateReports/{reportId} ------------------------------------
    // The reporter may read their own reports. Admin reads all.
    match /travelMateReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == uid());
      allow write: if false;
    }

    // ----- travelMateQuota/{uid} -------------------------------------------
    // Like-quota docs are written only by the travelMateSwipe CF.
    // The owner may read their own quota to render the paywall UI.
    match /travelMateQuota/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ----- poolRideRequests/{requestId} --------------------------------------
    // Server-authoritative (CF writes via Admin SDK).
    // Participants (leader + joined passengers) may read their own request.
    // The requesting passenger and driver are enforced at CF level — clients
    // never write fare, slots, driver, or status directly.
    match /poolRideRequests/{requestId} {
      allow read: if isSignedIn() && (
        uid() in resource.data.passengers
        || resource.data.driverId == uid()
        // The driver currently holding the exclusive offer, who is not yet
        // `driverId` and may never be. They need this to watch their own
        // countdown live rather than discover at the next poll that the ride
        // they were deciding on has already gone to somebody else.
        //
        // Reading one pool they have been offered is strictly less than
        // `getNearbyPoolRequests` already returns them about it, so this
        // discloses nothing new — it only makes it timely.
        //
        // Read through `get` with defaults, NOT as `resource.data.dispatch
        // .offeredDriverId`: every pool created before the ladder shipped has
        // no `dispatch` map, and a missing-field access is an error rather than
        // a false — which, in an `||` chain, denies the whole read. That would
        // have broken admin reads of the entire existing backlog.
        || resource.data.get('dispatch', {}).get('offeredDriverId', '') == uid()
        || isAdmin()
      );
      allow write: if false;

      // Riders waiting on the driver's yes or no for one of the free seats.
      // Written only by joinPoolRideRequest / driverRespondToPoolRequestJoin.
      match /joinRequests/{riderId} {
        allow read: if isAdmin()
                    || (isSignedIn() && riderId == uid())
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/poolRideRequests/$(requestId)).data.driverId == uid());
        allow write: if false;
      }
    }

    // ----- commuteSchedules/{uid} -------------------------------------------
    // One doc per user. Written only by upsertCommuteSchedule CF.
    // The owner may read their own schedule to pre-fill the form.
    // Drivers access aggregate demand via getCommuteDemand CF only —
    // the exact home/destination coordinates are NEVER returned to drivers.
    match /commuteSchedules/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- commuteRideClaims/{groupKeyAndDate} -------------------------------
    // One document per commute group per day, holding the shared ride that
    // group's members auto-book onto. Written only by runCommuteRideFormation
    // (commute/formRides.ts), inside the transaction that reads it — that
    // read-and-write is the lock that stops four riders on one route creating
    // four separate pools.
    //
    // Closed to clients entirely, reads included: the document lists the uids
    // of everyone who commutes together, which is precisely the thing the
    // commute feature never discloses. Riders learn about their ride from their
    // own trip document and their push, never from here.
    match /commuteRideClaims/{claimId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- scheduledRides/{scheduleId} ---------------------------------------
    // Recurring auto-booked rides. Written only by the upsertScheduledRide /
    // deleteScheduledRide CFs; the cron creates the actual trips. Owners read
    // their own schedules to render the "Scheduled rides" screen.
    match /scheduledRides/{scheduleId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    // ----- disputes/{disputeId} -----------------------------------------------
    // Created via the createDispute CF; resolved via resolveDispute CF.
    // The involved passenger/driver may read their own dispute; admins read all
    // (the web dashboard Disputes page lists open ones live).
    match /disputes/{disputeId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.passengerId == uid())
                  || (isSignedIn() && resource.data.driverId == uid());
      allow write: if false;
    }

    // ----- requestReports/{reportId} -------------------------------------------
    // A driver flagging a fake / abusive open request (reportOpenRequest CF).
    // The reporting driver may read their own report back; admins read all.
    // The reported passenger must NOT be able to read it — reports are not
    // disputes and are never disclosed to the person being reported.
    match /requestReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reportedBy == uid());
      allow write: if false;
    }

    // ----- franchises/{franchiseId} ---------------------------------------------
    // Created via adminCreateFranchise CF. Dashboard-only visibility.
    match /franchises/{franchiseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- driver_submissions/{id} ------------------------------------------
    // Drivers a Pro partner filed from their fleet portal, waiting on an admin.
    // Admin-read only: the owning partner reads their own through the
    // franchiseListDrivers callable, never by querying the collection, so one
    // partner can never widen the filter and enumerate a rival's fleet. Written
    // exclusively by Cloud Functions — a client-writable submission queue would
    // let a partner file a driver and mark it approved in the same breath.
    match /driver_submissions/{submissionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- fareConfig/{cityId} ----------------------------------------------
    // City-level fare engine rates (per-km / per-min, base fares, bid floors,
    // surge cap, pooling factors, commission). The booking screen reads these
    // to compute live estimates; admins edit them from the Fare Configuration
    // screen. The getFareEstimate / submitBid CFs read the same docs server-side.
    match /fareConfig/{cityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ----- The Pricing Engine's four collections ----------------------------
    // All written exclusively by Cloud Functions through the Admin SDK, which
    // bypasses these rules — so `write: if false` here costs the engine nothing
    // and closes every one of them to clients.
    //
    // They are also closed to clients for READING, which is the less obvious
    // half. Unlike fareConfig above (a published rate card every rider is
    // entitled to check), these documents are the engine's working state:
    //
    //  · surge/* and pricingZones/* say how many drivers are in a cell right
    //    now and how many riders are waiting. That is a live map of Velocity's
    //    supply, and a competitor with a passenger account could poll it.
    //  · pricingZones/* additionally contains the zone's driver queue, which
    //    names every driver in the area. No rider should ever hold that list,
    //    and no driver should be able to read their rivals' positions.
    //  · driverPresence/* is a driver's own online/offline history and their
    //    churn flag. The owner may read it — being able to see "you have gone
    //    offline six times this hour, which is why you keep losing your place"
    //    is the difference between a rule and a punishment nobody explained.
    //
    // Everything the apps legitimately need from these four is served by the
    // callables in pricing/functions.ts, shaped per caller: a rider gets a
    // multiplier and a label, a driver gets their own rank and nobody else's.

    // The multiplier fare/fareFunctions.ts reads on every quote.
    match /surge/{zoneKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Per-zone samples, the peak decision, the shock verdict and the queue.
    match /pricingZones/{zoneKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Confirmed pump prices: `current`, plus one document per effective date so
    // a fare queried months later can be checked against what was believed on
    // the day rather than what is believed now.
    match /fuelPrices/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // One document per driver: their presence log and churn score.
    match /driverPresence/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow write: if false;
    }

    // ----- notifications/{uid}/items/{notifId} -------------------------------
    // In-app notification feed. Written only server-side (notifyUser /
    // broadcastNotification via Admin SDK). The owner may read and mark read.
    match /notifications/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && onlyChanges(['read']);
      allow create, delete: if false;
    }

    // ----- intercityTrips/{tripId} -------------------------------------------
    // Scheduled city-to-city trips. Browsable by any signed-in user; created
    // and mutated only via the intercity CFs (Admin SDK bypasses rules).
    match /intercityTrips/{tripId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- intercityBookings/{bookingId} --------------------------------------
    // Written by createIntercityBooking CF. The booking passenger and admins
    // may read (the activity screen queries where passengerId == uid).
    match /intercityBookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.passengerId == uid());
      allow write: if false;
    }

    // ----- intercityChats/{tripId}/messages/{msgId} ----------------------------
    // Trip group chat. Writes go through sendIntercityMessage CF, which verifies
    // a confirmed booking. Reads are for the people booked on that trip:
    // createIntercityBooking adds the passenger to the trip's `memberUids`, and
    // cancelling their last booking takes them off. People post phone numbers
    // and pickup spots in here; `isSignedIn()` used to show them to everyone.
    match /intercityChats/{tripId}/messages/{msgId} {
      allow read: if isAdmin()
                  || (isSignedIn()
                      && uid() in get(/databases/$(database)/documents/intercityTrips/$(tripId)).data.get('memberUids', []));
      allow write: if false;
    }

    // ----- courierOrders/{orderId} ---------------------------------------------
    // Same-city parcel deliveries. Written via courier CFs. The ordering
    // passenger and admins may read (admin console lists all orders).
    match /courierOrders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.passengerId == uid());
      allow write: if false;
    }

    // ----- freightRequests/{requestId} -----------------------------------------
    // Business freight quote requests. Written via freight CFs. The requesting
    // passenger and admins may read.
    match /freightRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.passengerId == uid());
      allow write: if false;
    }

    // ----- supportChats/{uid} ---------------------------------------------------
    // The ORIGINAL single-thread support chat, superseded by supportTickets
    // below. Readable so an old conversation is not lost; no longer writable,
    // because nothing reads it any more — not the backend, not the console. A
    // message an old build wrote here was silently never answered; refused, it
    // shows that build an error and the person updates.
    match /supportChats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;

      match /messages/{msgId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ----- supportTickets/{ticketId} --------------------------------------------
    // Velocity Rapid Response System. One ticket per complaint, answered first
    // by the AI agent and then by a person.
    //
    // Reads are direct so a thread streams live without polling a callable.
    // Writes are ALL server-side, which is the difference from supportChats
    // above and the reason this replaced it: a client that can write into the
    // thread can forge a message from "Velocity Rides" — promising a refund, a
    // fee waiver, or an unlock — and then screenshot it. It also cannot run the
    // agent, count turns toward an escalation, or notify the desk.
    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow write: if false;

      match /messages/{msgId} {
        // The parent's userId is the only reader test that makes sense here, and
        // a message document deliberately does not carry it — so this reads the
        // parent. One extra document read per subscription, not per message.
        allow read: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == uid());
        allow write: if false;
      }
    }

    // ----- calls/{callId} -------------------------------------------------------
    // Free in-app voice calls between a rider and their driver (calls/index.ts).
    //
    // Only the startCall callable creates one, after checking both people are on
    // the same live ride. From then on the two phones run the call themselves,
    // and each writes only its own half: the caller its offer, the callee its
    // answer, either one the hang-up. An ended call stays ended, so a stale
    // screen cannot ring someone again by flipping a status back.
    match /calls/{callId} {
      allow read: if isSignedIn()
                  && (resource.data.callerId == uid() || resource.data.calleeId == uid());
      allow create, delete: if false;
      allow update: if isSignedIn()
                    && resource.data.status in ['ringing', 'active']
                    && ((resource.data.callerId == uid()
                         && onlyChanges(['offer', 'status', 'endedAt'])
                         && (request.resource.data.status == resource.data.status
                             || request.resource.data.status in ['cancelled', 'missed', 'ended']))
                        || (resource.data.calleeId == uid()
                         && onlyChanges(['answer', 'status', 'answeredAt', 'endedAt'])
                         && (request.resource.data.status == resource.data.status
                             || request.resource.data.status in ['active', 'declined', 'ended'])));
    }

    // ----- tripWatchLinks/{token} ----------------------------------------------
    // The secret tokens behind "share my ride with my family".
    //
    // Default-deny on purpose, including for the person who created the link. A
    // shared link is resolved ONLY through the `getTripWatch` callable, which
    // returns a hand-built, redacted view of the ride (trips/watch.ts). If this
    // collection were readable, a token would hand out the trip id, and the
    // trip's own read rule would then hand out everything else to anyone who
    // happened to be signed in.
    match /tripWatchLinks/{token} {
      allow read, write: if false;
    }

    // ===== Earn with Velocity — the Partner Program ==========================
    //
    // Every document below is money, or decides who gets money. NOTHING here is
    // client-writable: a partner who could edit their own wallet, referral edge
    // or transaction row could pay themselves. All writes go through the
    // partners/* callables, which is the only place the rules trust.
    //
    // Reads are scoped to the owner: a partner sees their own program and no
    // one else's, and a recruit can see the edge that binds them (so the app can
    // tell them who invited them) but not the fleet's earnings.

    // ----- partner_applications/{uid} --------------------------------------
    // The CNIC review queue. The applicant reads their own status (and the
    // rejection reason, so they know what to fix); admins read the queue.
    match /partner_applications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- partners/{uid} ---------------------------------------------------
    // The approved partner. `level`, `status` and every lifetime counter are
    // derived server-side — a self-promoted Diamond badge would be worth exactly
    // as much as the client's honesty.
    match /partners/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- partner_fleets/{fleetId} -----------------------------------------
    // Readable by any signed-in user: a recruit scanning a QR needs to resolve
    // the code to a fleet before they have any relationship to it. Nothing
    // sensitive lives here — a code, a name, and counters the owner already sees.
    match /partner_fleets/{fleetId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- driver_referrals / passenger_referrals ---------------------------
    // The permanent recruit → fleet edge. The recruit may read their own (to see
    // who invited them); the owning partner reads their roster through the
    // getPartnerFleetMembers callable, not directly, so one partner can never
    // enumerate another's members by querying the collection.
    match /driver_referrals/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }
    match /passenger_referrals/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- partner_wallets/{uid} --------------------------------------------
    match /partner_wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- partner_transactions/{txnId} -------------------------------------
    // The immutable commission receipt. Read-only to the partner it belongs to,
    // never writable by anyone but the settlement transaction.
    match /partner_transactions/{txnId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.partnerId == uid());
      allow write: if false;
    }

    // ----- withdraw_requests/{requestId} ------------------------------------
    // Created by requestPartnerWithdrawal (which debits the balance in the same
    // transaction), decided by adminReviewWithdrawal. A client-created request
    // would be a withdrawal that never debited anything.
    match /withdraw_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.partnerId == uid());
      allow write: if false;
    }

    // ----- partner fraud + device ledgers -----------------------------------
    // Admin-only. A partner who could read the fraud log would learn exactly
    // which of their tricks were detected and which were not.
    match /partner_fraud_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /partner_referral_devices/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===== Find your Customers — business proximity advertising ==============
    //
    // A business pays for a radius and pushes an offer to people inside it. The
    // money and the notification budget are both server-owned, so nothing here
    // is client-writable: an advertiser who could edit their own radius, slots or
    // expiry would be advertising for free, and one who could edit an impression
    // doc could reset their own notification cooldown and spam the same person
    // all day.

    // ----- businessAdApplications/{uid} --------------------------------------
    // The approval queue. Carries a payment screenshot and the advertiser's own
    // phone number, so only they and admins may read it.
    match /businessAdApplications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- businessAdvertisers/{uid} -----------------------------------------
    // The approved plan: radius, slots, expiry and lifetime counters.
    match /businessAdvertisers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- businessAds/{adId} -------------------------------------------------
    // The creatives. Readable by any signed-in user because that is the whole
    // point — a notified rider taps the push and the offer screen reads the doc.
    // Writes go through the businessAds callables, which enforce the slot limit
    // and copy the geography off the paid plan.
    match /businessAds/{adId} {
      allow read: if isSignedIn();
      allow write: if false;

      // Per-day rollups behind the analytics chart. Read by the owner and
      // admins; the advertiser dashboard callable reads them via the Admin SDK.
      match /daily/{day} {
        allow read: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/businessAds/$(adId)).data.ownerUid == uid());
        allow write: if false;
      }
    }

    // ----- businessAdImpressions/{adId}_{uid} --------------------------------
    // Who was notified, when, and whether they opened it. Admin-only: it is a
    // per-person location-adjacent record, and an advertiser has no business
    // knowing WHICH user walked past their shop — only how many did.
    match /businessAdImpressions/{impressionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- businessAdQueries/{adId}_{askerUid} --------------------------------
    // A customer's questions about one offer, and the business's answers. Only
    // the two people in the thread (and admins) may read it; the list query the
    // business runs is constrained by ownerUid, which this rule requires. Writes
    // go through the callables — every message is a push to someone else.
    //
    // The asker is also checked off the id itself ({adId}_{askerUid}): a
    // customer opening "Ask about this offer" listens to a thread that does not
    // exist until their first message, and a listener refused at that moment is
    // dead for good — the reply would never appear.
    match /businessAdQueries/{queryId} {
      allow read: if isAdmin()
                  || (isSignedIn()
                      && (resource.data.ownerUid == uid()
                          || resource.data.askerUid == uid()
                          || queryId.matches('^.+_' + uid() + '$')));
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAdmin()
                    || (isSignedIn()
                        && (queryId.matches('^.+_' + uid() + '$')
                            || get(/databases/$(database)/documents/businessAdQueries/$(queryId)).data.ownerUid == uid()));
        allow write: if false;
      }
    }

    // ----- businessAdQueryBlocks/{ownerUid}_{askerUid} ------------------------
    // Who blocked whom. Server-only: the threads mirror the flags for display,
    // and a client that could write here could unblock itself.
    match /businessAdQueryBlocks/{blockId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- businessAdQueryReports/{reportId} ----------------------------------
    // Reports carry a snapshot of both people's messages — admins only.
    match /businessAdQueryReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- businessAdNotifyBudget/{uid}_{day} --------------------------------
    // Today's per-person push allowance. Server-only — a client that could
    // write this could hand itself an unlimited number of offers.
    match /businessAdNotifyBudget/{docId} {
      allow read, write: if false;
    }

    // ----- specialRidesApplications/{uid} ------------------------------------
    // The rental car listing queue for admin approval. Carries insurance & registration
    // docs and contact info — owner and admins only.
    match /specialRidesApplications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- specialRidesListings/{uid} ----------------------------------------
    // Approved rental car listings. Readable by all signed-in users (passengers browsing),
    // owner and admins can read their own. Writes via callables only.
    match /specialRidesListings/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- specialRidesBookings/{bookingId} ----------------------------------
    // Rental car bookings. Readable by the renter, host and admins. Server-written only.
    match /specialRidesBookings/{bookingId} {
      allow read: if isSignedIn()
                  && (uid() == get(/databases/$(database)/documents/specialRidesBookings/$(bookingId)).data.uid
                      || uid() == get(/databases/$(database)/documents/specialRidesBookings/$(bookingId)).data.hostUid
                      || isAdmin());
      allow write: if false;
    }

    // ----- userPresence/{uid} -----------------------------------------------
    // "Somebody with the app is around here." One doc per user, holding their
    // last known coarse position, written by their own handset while the app is
    // open. It is what puts the red dots on the passenger home map.
    //
    // WRITE is owner-only and field-whitelisted, and follows the same reasoning
    // as drivers/{uid}: a location beacon that ran through a Cloud Function
    // would cost an invocation per ping for a decorative map layer.
    //
    // READ is owner + admin ONLY, deliberately. No user may query this
    // collection — anyone who could would have a live "where is everyone"
    // feed keyed by uid. The map layer goes through the getNearbyActivity
    // callable instead, which returns blurred, anonymous, un-attributable
    // points and never the underlying documents.
    //
    // Docs self-delete via a Firestore TTL policy on `expireAt` (see
    // docs/HARDENING.md), so a user who stops opening the app stops being on
    // anybody's map.
    match /userPresence/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'lat', 'lng', 'geohash', 'lastSeenAt', 'expireAt']);
      allow update: if isOwner(userId)
                    && onlyChanges(['lat', 'lng', 'geohash', 'lastSeenAt', 'expireAt']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ----- otpChallenges/{challengeId} --------------------------------------
    // Live sign-in codes. The catch-all below would deny these anyway; they are
    // named here because of what one read would be worth. A client that could
    // read this collection could read the hash of a code being sent to somebody
    // else's phone right now, and six digits do not survive an offline attack —
    // which would turn "log in as anyone" into a query. Only server code with
    // the Admin SDK, which bypasses these rules, ever touches them.
    //
    // Docs self-delete via a Firestore TTL policy on `expireAt` (see
    // docs/HARDENING.md); the code itself is dead five minutes in regardless.
    match /otpChallenges/{challengeId} {
      allow read, write: if false;
    }

    // ----- mapsCache/{key}, mapsPlaceIds/{key} ------------------------------
    // Cached Google Maps answers. The catch-all below would deny these anyway;
    // they are named because of what a client write would mean rather than what
    // a read would be worth.
    //
    // These documents are the licence boundary (see
    // backend/functions/src/lib/mapsCache.ts). `mapsCache` holds coordinates and
    // polylines we are only allowed to keep for 30 days, and every document
    // carries the `expireAt` that proves it. A client that could write here could
    // push that expiry out and quietly put us in breach of the Google Maps
    // Platform terms — or poison a coordinate and send a passenger to the wrong
    // address. Only server code with the Admin SDK, which bypasses these rules,
    // ever touches either collection.
    //
    // `mapsPlaceIds` holds place IDs only, never coordinates, which is why it has
    // no expiry: place IDs are expressly exempt from the caching restrictions.
    // Never merge the two collections to "simplify" this.
    match /mapsCache/{key} {
      allow read, write: if false;
    }
    match /mapsPlaceIds/{key} {
      allow read, write: if false;
    }

    // ----- velocityLocations/{id} -------------------------------------------
    // Velocity's own map. Read-only to signed-in clients so the app can resolve a
    // place without a callable round trip; all writes are server-side (the trip
    // promoter and the admin desk).
    //
    // Why clients may read it but not write it: every coordinate in here is a
    // first-party measurement, and `coordSource` is what makes that auditable. A
    // client that could write would be able to launder a Google coordinate into a
    // collection that has no expiry — which is exactly the licence breach this
    // collection is designed around (backend/functions/src/locations/registry.ts).
    // It could also move a verified pin and misdirect every future passenger.
    match /velocityLocations/{locationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- trafficAlerts/{id} ----------------------------------------------
    // Road alerts classified out of Pakistani news feeds. No client touches
    // this collection directly: `getTrafficAlerts` serves it, because what a
    // rider may see is a city filter and what a driver may see is a route
    // filter, and neither is expressible as a security rule.
    //
    // Writes are the scheduled run only. A client that could write here could
    // put "SHAHRAH-E-FAISAL CLOSED" on every booking screen in Karachi, which
    // is a cheap way to move a city's demand somewhere a competitor wants it.
    match /trafficAlerts/{alertId} {
      allow read, write: if false;
    }

    // ----- Catch-all DENY --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
