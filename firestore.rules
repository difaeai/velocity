rules_version = '2';

// ============================================================================
//  Velocity — Firestore Security Rules
// ----------------------------------------------------------------------------
//  Security model (see docs/SECURITY.md):
//   * Default DENY. Nothing is accessible unless a rule below explicitly allows.
//   * Authentication is REQUIRED for every read and write.
//   * Roles are carried in custom claims (request.auth.token.role), which are
//     ONLY settable by the backend (Cloud Functions via the Admin SDK).
//   * Money, verification status, ratings, trip state and counters are
//     SERVER-AUTHORITATIVE: clients can never write them directly. Those paths
//     are written exclusively by Cloud Functions, which bypass these rules.
//   * Where clients may write at all, writes are restricted to an explicit
//     whitelist of fields so privileged fields cannot be smuggled in.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    function role() {
      return isSignedIn() ? request.auth.token.role : '';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isDriver() {
      return role() == 'driver';
    }

    // True when the incoming write only touches the supplied field names.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ----- users/{uid} -----------------------------------------------------
    // Profile docs. Created by the onUserCreate backend trigger. The owner may
    // edit only safe profile fields; role / verification / wallet live elsewhere
    // or are server-only.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      // create only happens during the race before onUserCreate trigger fires
      allow create: if isOwner(userId);
      // update: owner may only touch safe profile fields — role is server-only.
      // mixedRideOk is the pool-ride opposite-gender opt-in toggled from the
      // nearby-rides screens.
      allow update: if isOwner(userId)
                    && onlyChanges(['displayName', 'name', 'gender', 'dob', 'age',
                                    'profileComplete', 'photoURL', 'lastActive', 'updatedAt',
                                    'mixedRideOk']);
      allow update, delete: if isAdmin();

      // Saved places (home / work / favourites) — owner-managed bookmarks.
      match /savedPlaces/{placeId} {
        allow read, write: if isOwner(userId);
      }

      // Daily routes — owner-managed commutes that trigger public-pool alerts.
      // The match runs server-side via a collection-group scan (admin SDK), so
      // no group-scope read exception is needed here.
      match /dailyRoutes/{routeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ----- cnicVerifications/{uid} -----------------------------------------
    // The admin review queue for passenger CNIC verification (the identity gate
    // in front of couriers). Written only by the submitCnicVerification /
    // adminReviewCnicVerification functions; the owner may read their own
    // submission back, admins read the whole queue. The authoritative copy the
    // app gates on lives on users/{uid}.cnicVerification, which is outside the
    // owner-writable whitelist above — so status is server-only either way.
    match /cnicVerifications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- drivers/{uid} ---------------------------------------------------
    // Driver operational doc. Verification, rating, earnings and commission are
    // server-only. The driver may update ONLY presence/location fields so GPS
    // pings don't require a function call on every update.
    match /drivers/{driverId} {
      allow read: if isOwner(driverId) || isAdmin();
      allow create: if false;
      // `appActiveAt` is the driver app's foreground heartbeat, written every
      // couple of minutes while any driver screen is on screen. The backend
      // reads it to tell "offline" apart from "app closed" before spending a
      // paid WhatsApp message on somebody who is looking at the app already.
      // Self-reported and therefore only ever used to send LESS: a driver who
      // lied about it would only suppress their own alerts.
      allow update: if isOwner(driverId)
                    && isDriver()
                    && onlyChanges(['online', 'lastLocation', 'heading', 'lastSeenAt',
                                    'appActiveAt',
                                    'poolPickupRadiusM', 'poolDropoffRadiusM']);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ----- trips/{tripId} --------------------------------------------------
    // Fully server-authoritative. Trips are created and mutated only by Cloud
    // Functions. Clients READ if they are a participant; they ACT via callables.
    match /trips/{tripId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.passengerId == uid())
                  || (isSignedIn() && resource.data.driverId == uid())
                  // Pool riders who joined via a share link track the trip live.
                  || (isSignedIn()
                      && 'poolMembers' in resource.data
                      && uid() in resource.data.poolMembers);
      // Everything that matters about a trip — status, fare, who is driving —
      // is server-only and stays that way.
      //
      // The one exception is the driver's own position while they are the
      // assigned driver. The passenger cannot read `drivers/{id}` (that document
      // is the driver's alone), so without a copy on the trip there is no way to
      // show "4 min away" — the rider is left watching a static map wondering if
      // anyone is coming. Relaying it through a callable would mean a function
      // invocation every few seconds for every driver on the road, which is a
      // lot of money to spend on a coordinate.
      //
      // Scoped as tightly as it can be: only the assigned driver, only while the
      // ride is live, and only these two fields — so it cannot be used to touch
      // a fare, a status, or anyone else's trip.
      allow update: if isSignedIn()
                    && resource.data.driverId == uid()
                    && resource.data.status in ['matched', 'arriving', 'arrived', 'in_progress']
                    && onlyChanges(['driverLocation', 'driverLocationAt']);
      allow create, delete: if false;

      // Bids placed by drivers (created server-side via placeBid). The passenger
      // who owns the parent trip and the bidding driver may read.
      match /bids/{bidId} {
        allow read: if isAdmin()
                    || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == uid())
                    || (isSignedIn() && resource.data.driverId == uid());
        allow write: if false;
      }

      // In-ride chat between the matched passenger and driver.
      match /chat/{msgId} {
        allow read: if isAdmin()
                    || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == uid())
                    || (isSignedIn() && get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == uid());
        allow create: if isSignedIn()
                      && (
                        get(/databases/$(database)/documents/trips/$(tripId)).data.passengerId == uid()
                        || get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == uid()
                      )
                      && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'sentAt'])
                      && request.resource.data.senderId == uid()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      // Riders asking the driver for one of this pool's free seats. Written
      // only by joinPoolTrip / driverRespondToPoolJoin (Admin SDK). The rider
      // watches their own request go from pending to accepted or rejected; the
      // driver reads the queue they have to answer.
      match /joinRequests/{riderId} {
        allow read: if isAdmin()
                    || (isSignedIn() && riderId == uid())
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == uid());
        allow write: if false;
      }

      // Who was picked up along the way, and when. Everyone in the car may read
      // it — knowing exactly who got in is the point of the feature, not a
      // detail of it. Written only by acceptEnRouteRider (Admin SDK).
      match /enRouteLog/{entryId} {
        allow read: if isAdmin()
                    || (isSignedIn()
                        && uid() in get(/databases/$(database)/documents/trips/$(tripId)).data.poolMembers)
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/trips/$(tripId)).data.driverId == uid());
        allow write: if false;
      }
    }

    // ----- driverRoutes/{driverId} -----------------------------------------
    // A driver's declared route ("I'm heading home") — the corridor that
    // getEnRouteMatches searches for riders on their way. Only the driver
    // themselves reads it; only the backend writes it, so a driver cannot widen
    // their own corridor to sweep up rides that are not on their route.
    match /driverRoutes/{driverId} {
      allow read: if isAdmin() || (isSignedIn() && driverId == uid());
      allow write: if false;
    }

    // ----- poolRides/{rideId} ----------------------------------------------
    // Seats / status / gender counters are mutated ONLY by the joinPoolRide /
    // driverAcceptPoolBatch / startPoolBoarding CFs (Admin SDK). The owning
    // driver may edit their own offer; nobody else writes.
    match /poolRides/{rideId} {
      allow read: if isSignedIn();
      allow create: if isDriver() && request.resource.data.driverId == uid();
      allow update: if isDriver() && resource.data.driverId == uid();
      allow delete: if false;

      // Passenger seat docs are created exclusively by the joinPoolRide CF —
      // a direct client create would bypass seat limits and gender rules.
      match /passengers/{passengerId} {
        allow read: if isSignedIn() && (uid() == passengerId || isDriver() || isAdmin());
        allow create: if false;
        allow update: if (isDriver() && get(/databases/$(database)/documents/poolRides/$(rideId)).data.driverId == uid())
                      || isAdmin();
        allow delete: if false;
      }

      // Queued join requests for mixed (1M+1F) pools. Written only by the
      // joinPoolRide / driverAcceptPoolBatch CFs. The requester sees their own
      // request; the ride's driver sees the queue to accept same-gender pairs.
      match /joinRequests/{userId} {
        allow read: if isSignedIn() && (
          uid() == userId
          || get(/databases/$(database)/documents/poolRides/$(rideId)).data.driverId == uid()
          || isAdmin()
        );
        allow write: if false;
      }

      // Group chat for the pool ride (driver + all passengers)
      match /chat/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'sentAt'])
                      && request.resource.data.senderId == uid()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // ----- ratings/{ratingId} ----------------------------------------------
    // Written exclusively by the submitRating Cloud Function.
    match /ratings/{ratingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.raterId == uid());
      allow write: if false;
    }

    // ----- wallets/{uid} ---------------------------------------------------
    // Balances and ledger are server-only writes. Owner and admin may read.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;

      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ----- safetyEvents/{id} ----------------------------------------------
    // SOS / route-deviation records. Created server-side. The reporter and any
    // admin may read; nobody writes directly.
    match /safetyEvents/{eventId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.reportedBy == uid());
      allow write: if false;
    }

    // ----- system/{doc} ----------------------------------------------------
    // Platform counters (revenue, commissions, payouts). Admin-readable for the
    // dashboard; never client-writable.
    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- adminConfig/{doc} -----------------------------------------------
    // Console-only configuration, admin-readable AND admin-writable. Distinct
    // from config/{doc}, which every signed-in app user can read: the one doc
    // here (platformCosts) is what Velocity pays its vendors, and no passenger
    // or driver has any business seeing the company's bill.
    match /adminConfig/{docId} {
      allow read, write: if isAdmin();
    }

    // ----- auditLogs/{id} --------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- analyticsDaily/{YYYY-MM-DD} -------------------------------------
    // One rolled-up day of platform activity, written by adminGetAnalytics the
    // first time anyone asks for that day. Feeds the dashboard charts.
    match /analyticsDaily/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialAccounts/{platform} ---------------------------------------
    // The connected Facebook / Instagram / YouTube / TikTok accounts. The
    // profile half is admin-readable so the console can show live status.
    match /socialAccounts/{platform} {
      allow read: if isAdmin();
      allow write: if false;

      // The access tokens, sealed with SOCIAL_TOKEN_KEY. Closed to every
      // client including admins: a page token is a password that can post to
      // the whole audience, and only Cloud Functions has any business holding
      // one. Subcollections do not inherit the rule above, so this is the rule
      // that actually keeps them shut.
      match /secret/{docId} {
        allow read, write: if false;
      }
    }

    // ----- socialEmployees/{id} --------------------------------------------
    // The people hired onto the social desk: name, job, personal direction and
    // what they have worked on. Admin-readable so the console can render the
    // roster live; written only through the hire/update/fire callables, because
    // who works here decides what gets published in Velocity name.
    match /socialEmployees/{employeeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialPosts/{YYYY-MM-DD-format} ---------------------------------
    // One piece the crew made: the plan, script, media, per-network results and
    // the round-by-round feedback an admin gave on it.
    match /socialPosts/{postId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialResearch/{YYYY-MM-DD} -------------------------------------
    // The writer's market read for one day, with the pages it came from. Cached
    // so a second run the same morning does not pay for the search twice.
    match /socialResearch/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- socialComments/{platform_commentId} ------------------------------
    // What people said under our own posts, and the reply the manager drafted.
    // Written only by the backend: a reply that leaves this collection is
    // Velocity speaking in public, so it goes out through a callable that
    // checks admin, never through a client write.
    match /socialComments/{commentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- platformLedger/{id} ----------------------------------------------
    // Realized platform revenue (ride commissions, subscription payments).
    // Written only by the backend inside money transactions; admin-readable.
    match /platformLedger/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- config/{doc} ----------------------------------------------------
    // Public app configuration (ride types, base fares, service areas). Any
    // authenticated user may read; only admins may change it.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ----- paymentIntents/{id} & payouts/{id} -----------------------------
    // Wallet top-up intents and driver payout requests. Written only by the
    // backend; the owner and admins may read.
    match /paymentIntents/{intentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }
    match /payouts/{payoutId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.driverId == uid());
      allow write: if false;
    }

    // ----- paymentMethods/{id} --------------------------------------------
    // Connected Easypaisa/JazzCash/bank/card instruments. The owner may READ
    // the display data (kind, masked tail, default flag) so the app can render
    // the Payment methods screen live, but never writes: connecting, removing
    // and re-defaulting all go through callables that also talk to the gateway.
    match /paymentMethods/{methodId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    // The setup handshake — readable by its owner so the app can watch a
    // connection complete. Never client-written.
    match /paymentMethodSetups/{setupId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    // ----- payment secrets -------------------------------------------------
    // The gateway tokens themselves: the one thing that can actually move
    // money without the user present. NOBODY reads these from a client, not
    // even the owner and not even an admin — only server code with the Admin
    // SDK, which bypasses rules. Same posture as paymentIntentSecrets.
    match /paymentMethodSecrets/{methodId} {
      allow read, write: if false;
    }
    match /paymentMethodSetupSecrets/{setupId} {
      allow read, write: if false;
    }

    // ----- commissionSettlements/{id} -------------------------------------
    // Manual settlements (bank transfer + AI-verified screenshot): driver
    // commission cycles AND cancellation fees owed by passengers or drivers.
    // Written only by the backend; the payer and admins may read.
    match /commissionSettlements/{settlementId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.driverId == uid())
                  || (isSignedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    // ----- openRequests/{tripId} ------------------------------------------
    // Public-safe feed of open ride requests, written only by the backend.
    // Approved drivers (driver role) read it to discover work; the full trip
    // document stays private to its participants.
    match /openRequests/{tripId} {
      allow read: if isDriver();
      allow write: if false;
    }

    // ----- travelMatePlans/{planId} ----------------------------------------
    // Any authenticated user can browse plans (needed for the subscription
    // purchase screen). Writes go exclusively through the CF (Admin SDK).
    match /travelMatePlans/{planId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- travelMateSubscriptions/{subId} ---------------------------------
    // A user may read (and list) their own subscriptions.
    // Admin reads all. All writes go through the CF.
    match /travelMateSubscriptions/{subId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    // ----- travelMateProfiles/{uid} ----------------------------------------
    match /travelMateProfiles/{userId} {
      // Owner reads own profile to pre-fill the setup form.
      // Any signed-in user can read profiles to show swipe deck cards.
      allow read: if isSignedIn();
      // Owner writes own profile directly from the setup screen — but only the
      // fields that screen edits. Rating / moderation fields stay server-only.
      // displayNameLower powers people search; createdAt is the "joined" date.
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'displayName', 'displayNameLower', 'age', 'gender',
                          'genderPref', 'bio',
                          'interests', 'photoURL', 'active', 'lastActive', 'createdAt',
                          'location', 'searchRadiusKm',
                          'travelPrefs', 'travelPrefsUpdatedAt']);
      allow update: if isOwner(userId)
                    && onlyChanges(['displayName', 'displayNameLower', 'age', 'gender',
                                    'genderPref', 'bio',
                                    'interests', 'photoURL', 'active', 'lastActive', 'createdAt',
                                    'location', 'searchRadiusKm',
                                    'travelPrefs', 'travelPrefsUpdatedAt']);
      allow delete: if false;
    }

    // ----- travelMatePosts/{postId} ----------------------------------------
    // Community feed posts. Created/liked/commented/deleted ONLY via the
    // community CFs (server keeps the like/comment counters authoritative and
    // handles media upload). Any signed-in user may read the feed.
    match /travelMatePosts/{postId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Post likes + comments live in subcollections of travelMatePosts.
    // Matched with path=** so both direct reads and collection-group queries
    // (profile "Comments" / "Likes" tabs) work. Only the community CFs write.
    // NOTE: these names are only used under travelMatePosts today — keep new
    // collections from being named `comments`/`likes` unless they may be public.
    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /{path=**}/likes/{likeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- travelMateFollows/{followerId_followedId} ------------------------
    // Public follow graph for the community feed. The doc ID MUST encode the
    // real follower (same trick as swipes) so nobody can forge a follow from
    // someone else. Reads are open to signed-in users: follower/following
    // counts and lists are public social data.
    match /travelMateFollows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.followerId == uid()
                    && request.resource.data.followedId is string
                    && request.resource.data.followedId != uid()
                    && followId == uid() + '_' + request.resource.data.followedId;
      allow delete: if isSignedIn() && resource.data.followerId == uid();
      allow update: if false;
    }

    // ----- travelMateBlocks/{blockerId_blockedId} ---------------------------
    // Written only by the blockTravelMateUser / unblockTravelMateUser CFs
    // (blocking also severs follows and closes any open chat server-side).
    // PRIVATE: only the blocker (and admins) may read their own block list —
    // the blocked user must never learn they were blocked.
    match /travelMateBlocks/{blockId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.blockerId == uid());
      allow write: if false;
    }

    // ----- travelMateCommunities/{communityId} ------------------------------
    // City-based community groups. Every community is pinned to a city so
    // members always see where it belongs. Create/join/leave go through the
    // community CFs (membership counters are server-authoritative). Browsable
    // by any signed-in user.
    match /travelMateCommunities/{communityId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- travelMateSwipes/{swipeId} ----------------------------------------
    // swipeId format: {swiperId}_{swipedId}. The doc ID MUST encode the real
    // swiper — otherwise a user could forge someone else's like and then
    // create a "mutual" match below.
    match /travelMateSwipes/{swipeId} {
      allow read: if isSignedIn() && (
        resource.data.swiperId == uid() || resource.data.swipedId == uid()
      );
      allow create: if isSignedIn()
                    && request.resource.data.swiperId == uid()
                    && request.resource.data.swipedId is string
                    && request.resource.data.swipedId != uid()
                    && swipeId == uid() + '_' + request.resource.data.swipedId
                    && request.resource.data.direction in ['like', 'pass'];
      allow update, delete: if false;
    }

    // ----- travelMateMatches/{matchId} -------------------------------------
    // A match doc's `users` array contains exactly two sorted UIDs.
    // Only the two matched users may read the match or its chat.
    // Creation requires a verified MUTUAL like: both swipe docs must exist
    // with direction == 'like' (swipe doc IDs are bound to the swiper above,
    // so neither can be forged).
    match /travelMateMatches/{matchId} {
      allow read: if isSignedIn() && uid() in resource.data.users;
      allow create: if isSignedIn()
                    && uid() in request.resource.data.users
                    && request.resource.data.users.size() == 2
                    && request.resource.data.users[0] != request.resource.data.users[1]
                    && matchId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
                    && get(/databases/$(database)/documents/travelMateSwipes/$(request.resource.data.users[0] + '_' + request.resource.data.users[1])).data.direction == 'like'
                    && get(/databases/$(database)/documents/travelMateSwipes/$(request.resource.data.users[1] + '_' + request.resource.data.users[0])).data.direction == 'like';
      allow update: if false;
      allow delete: if false;

      match /chat/{msgId} {
        allow read: if isSignedIn()
                    && uid() in get(/databases/$(database)/documents/travelMateMatches/$(matchId)).data.users;
        allow create: if isSignedIn()
                      && uid() in get(/databases/$(database)/documents/travelMateMatches/$(matchId)).data.users
                      && request.resource.data.senderId == uid()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      // CF (sendTravelMateMessage) writes here; clients may only read.
      match /messages/{msgId} {
        allow read: if isSignedIn()
                    && uid() in get(/databases/$(database)/documents/travelMateMatches/$(matchId)).data.users;
        allow write: if false;
      }
    }

    // ----- travelMateGroups/{groupId} --------------------------------------
    // Only group members may read their group or its settlement history.
    // All writes go through the CF (Admin SDK).
    match /travelMateGroups/{groupId} {
      allow read: if isSignedIn() && uid() in resource.data.members;
      allow write: if false;

      match /settlements/{tripId} {
        allow read: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/travelMateGroups/$(groupId)).data.members;
        allow write: if false;
      }

      // Joint group chat. CF (sendTravelMateGroupMessage) is the primary
      // writer (it also pushes FCM); a member may create a plain text message
      // directly as a fallback path.
      match /messages/{msgId} {
        allow read: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/travelMateGroups/$(groupId)).data.members;
        allow create: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/travelMateGroups/$(groupId)).data.members
          && request.resource.data.senderId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ----- travelMateSharedRides/{shareId} ----------------------------------
    // Shareable ride links. Resolution + booking go through CFs (which gate on
    // travel-partner status); direct reads are limited to people already on
    // the ride so live co-rider updates work.
    match /travelMateSharedRides/{shareId} {
      allow read: if isSignedIn() && uid() in resource.data.coRiders;
      allow write: if false;
    }

    // ----- travelMateReports/{reportId} ------------------------------------
    // The reporter may read their own reports. Admin reads all.
    match /travelMateReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == uid());
      allow write: if false;
    }

    // ----- travelMateQuota/{uid} -------------------------------------------
    // Like-quota docs are written only by the travelMateSwipe CF.
    // The owner may read their own quota to render the paywall UI.
    match /travelMateQuota/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ----- poolRideRequests/{requestId} --------------------------------------
    // Server-authoritative (CF writes via Admin SDK).
    // Participants (leader + joined passengers) may read their own request.
    // The requesting passenger and driver are enforced at CF level — clients
    // never write fare, slots, driver, or status directly.
    match /poolRideRequests/{requestId} {
      allow read: if isSignedIn() && (
        uid() in resource.data.passengers
        || resource.data.driverId == uid()
        || isAdmin()
      );
      allow write: if false;

      // Riders waiting on the driver's yes or no for one of the free seats.
      // Written only by joinPoolRideRequest / driverRespondToPoolRequestJoin.
      match /joinRequests/{riderId} {
        allow read: if isAdmin()
                    || (isSignedIn() && riderId == uid())
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/poolRideRequests/$(requestId)).data.driverId == uid());
        allow write: if false;
      }
    }

    // ----- commuteSchedules/{uid} -------------------------------------------
    // One doc per user. Written only by upsertCommuteSchedule CF.
    // The owner may read their own schedule to pre-fill the form.
    // Drivers access aggregate demand via getCommuteDemand CF only —
    // the exact home/destination coordinates are NEVER returned to drivers.
    match /commuteSchedules/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- scheduledRides/{scheduleId} ---------------------------------------
    // Recurring auto-booked rides. Written only by the upsertScheduledRide /
    // deleteScheduledRide CFs; the cron creates the actual trips. Owners read
    // their own schedules to render the "Scheduled rides" screen.
    match /scheduledRides/{scheduleId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    // ----- disputes/{disputeId} -----------------------------------------------
    // Created via the createDispute CF; resolved via resolveDispute CF.
    // The involved passenger/driver may read their own dispute; admins read all
    // (the web dashboard Disputes page lists open ones live).
    match /disputes/{disputeId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.passengerId == uid())
                  || (isSignedIn() && resource.data.driverId == uid());
      allow write: if false;
    }

    // ----- requestReports/{reportId} -------------------------------------------
    // A driver flagging a fake / abusive open request (reportOpenRequest CF).
    // The reporting driver may read their own report back; admins read all.
    // The reported passenger must NOT be able to read it — reports are not
    // disputes and are never disclosed to the person being reported.
    match /requestReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reportedBy == uid());
      allow write: if false;
    }

    // ----- franchises/{franchiseId} ---------------------------------------------
    // Created via adminCreateFranchise CF. Dashboard-only visibility.
    match /franchises/{franchiseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- driver_submissions/{id} ------------------------------------------
    // Drivers a Pro partner filed from their fleet portal, waiting on an admin.
    // Admin-read only: the owning partner reads their own through the
    // franchiseListDrivers callable, never by querying the collection, so one
    // partner can never widen the filter and enumerate a rival's fleet. Written
    // exclusively by Cloud Functions — a client-writable submission queue would
    // let a partner file a driver and mark it approved in the same breath.
    match /driver_submissions/{submissionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- fareConfig/{cityId} ----------------------------------------------
    // City-level fare engine rates (per-km / per-min, base fares, bid floors,
    // surge cap, pooling factors, commission). The booking screen reads these
    // to compute live estimates; admins edit them from the Fare Configuration
    // screen. The getFareEstimate / submitBid CFs read the same docs server-side.
    match /fareConfig/{cityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ----- notifications/{uid}/items/{notifId} -------------------------------
    // In-app notification feed. Written only server-side (notifyUser /
    // broadcastNotification via Admin SDK). The owner may read and mark read.
    match /notifications/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && onlyChanges(['read']);
      allow create, delete: if false;
    }

    // ----- intercityTrips/{tripId} -------------------------------------------
    // Scheduled city-to-city trips. Browsable by any signed-in user; created
    // and mutated only via the intercity CFs (Admin SDK bypasses rules).
    match /intercityTrips/{tripId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- intercityBookings/{bookingId} --------------------------------------
    // Written by createIntercityBooking CF. The booking passenger and admins
    // may read (the activity screen queries where passengerId == uid).
    match /intercityBookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.passengerId == uid());
      allow write: if false;
    }

    // ----- intercityChats/{tripId}/messages/{msgId} ----------------------------
    // Trip group chat. Writes go through sendIntercityMessage CF, which verifies
    // a confirmed booking. Reads are signed-in only — bookings are keyed by
    // bookingId, so there is no per-uid doc to gate reads against.
    match /intercityChats/{tripId}/messages/{msgId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- courierOrders/{orderId} ---------------------------------------------
    // Same-city parcel deliveries. Written via courier CFs. The ordering
    // passenger and admins may read (admin console lists all orders).
    match /courierOrders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.passengerId == uid());
      allow write: if false;
    }

    // ----- freightRequests/{requestId} -----------------------------------------
    // Business freight quote requests. Written via freight CFs. The requesting
    // passenger and admins may read.
    match /freightRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.passengerId == uid());
      allow write: if false;
    }

    // ----- supportChats/{uid} ---------------------------------------------------
    // 1:1 support thread. The owner writes their own messages directly from the
    // app; admins can read (and later reply from an admin console).
    match /supportChats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin())
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    // ===== Earn with Velocity — the Partner Program ==========================
    //
    // Every document below is money, or decides who gets money. NOTHING here is
    // client-writable: a partner who could edit their own wallet, referral edge
    // or transaction row could pay themselves. All writes go through the
    // partners/* callables, which is the only place the rules trust.
    //
    // Reads are scoped to the owner: a partner sees their own program and no
    // one else's, and a recruit can see the edge that binds them (so the app can
    // tell them who invited them) but not the fleet's earnings.

    // ----- partner_applications/{uid} --------------------------------------
    // The CNIC review queue. The applicant reads their own status (and the
    // rejection reason, so they know what to fix); admins read the queue.
    match /partner_applications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- partners/{uid} ---------------------------------------------------
    // The approved partner. `level`, `status` and every lifetime counter are
    // derived server-side — a self-promoted Diamond badge would be worth exactly
    // as much as the client's honesty.
    match /partners/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- partner_fleets/{fleetId} -----------------------------------------
    // Readable by any signed-in user: a recruit scanning a QR needs to resolve
    // the code to a fleet before they have any relationship to it. Nothing
    // sensitive lives here — a code, a name, and counters the owner already sees.
    match /partner_fleets/{fleetId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- driver_referrals / passenger_referrals ---------------------------
    // The permanent recruit → fleet edge. The recruit may read their own (to see
    // who invited them); the owning partner reads their roster through the
    // getPartnerFleetMembers callable, not directly, so one partner can never
    // enumerate another's members by querying the collection.
    match /driver_referrals/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }
    match /passenger_referrals/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- partner_wallets/{uid} --------------------------------------------
    match /partner_wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- partner_transactions/{txnId} -------------------------------------
    // The immutable commission receipt. Read-only to the partner it belongs to,
    // never writable by anyone but the settlement transaction.
    match /partner_transactions/{txnId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.partnerId == uid());
      allow write: if false;
    }

    // ----- withdraw_requests/{requestId} ------------------------------------
    // Created by requestPartnerWithdrawal (which debits the balance in the same
    // transaction), decided by adminReviewWithdrawal. A client-created request
    // would be a withdrawal that never debited anything.
    match /withdraw_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.partnerId == uid());
      allow write: if false;
    }

    // ----- partner fraud + device ledgers -----------------------------------
    // Admin-only. A partner who could read the fraud log would learn exactly
    // which of their tricks were detected and which were not.
    match /partner_fraud_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /partner_referral_devices/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===== Find your Customers — business proximity advertising ==============
    //
    // A business pays for a radius and pushes an offer to people inside it. The
    // money and the notification budget are both server-owned, so nothing here
    // is client-writable: an advertiser who could edit their own radius, slots or
    // expiry would be advertising for free, and one who could edit an impression
    // doc could reset their own notification cooldown and spam the same person
    // all day.

    // ----- businessAdApplications/{uid} --------------------------------------
    // The approval queue. Carries a payment screenshot and the advertiser's own
    // phone number, so only they and admins may read it.
    match /businessAdApplications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- businessAdvertisers/{uid} -----------------------------------------
    // The approved plan: radius, slots, expiry and lifetime counters.
    match /businessAdvertisers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- businessAds/{adId} -------------------------------------------------
    // The creatives. Readable by any signed-in user because that is the whole
    // point — a notified rider taps the push and the offer screen reads the doc.
    // Writes go through the businessAds callables, which enforce the slot limit
    // and copy the geography off the paid plan.
    match /businessAds/{adId} {
      allow read: if isSignedIn();
      allow write: if false;

      // Per-day rollups behind the analytics chart. Read by the owner and
      // admins; the advertiser dashboard callable reads them via the Admin SDK.
      match /daily/{day} {
        allow read: if isAdmin()
                    || (isSignedIn()
                        && get(/databases/$(database)/documents/businessAds/$(adId)).data.ownerUid == uid());
        allow write: if false;
      }
    }

    // ----- businessAdImpressions/{adId}_{uid} --------------------------------
    // Who was notified, when, and whether they opened it. Admin-only: it is a
    // per-person location-adjacent record, and an advertiser has no business
    // knowing WHICH user walked past their shop — only how many did.
    match /businessAdImpressions/{impressionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- businessAdNotifyBudget/{uid}_{day} --------------------------------
    // Today's per-person push allowance. Server-only — a client that could
    // write this could hand itself an unlimited number of offers.
    match /businessAdNotifyBudget/{docId} {
      allow read, write: if false;
    }

    // ----- specialRidesApplications/{uid} ------------------------------------
    // The rental car listing queue for admin approval. Carries insurance & registration
    // docs and contact info — owner and admins only.
    match /specialRidesApplications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ----- specialRidesListings/{uid} ----------------------------------------
    // Approved rental car listings. Readable by all signed-in users (passengers browsing),
    // owner and admins can read their own. Writes via callables only.
    match /specialRidesListings/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ----- specialRidesBookings/{bookingId} ----------------------------------
    // Rental car bookings. Readable by the renter, host and admins. Server-written only.
    match /specialRidesBookings/{bookingId} {
      allow read: if isSignedIn()
                  && (uid() == get(/databases/$(database)/documents/specialRidesBookings/$(bookingId)).data.uid
                      || uid() == get(/databases/$(database)/documents/specialRidesBookings/$(bookingId)).data.hostUid
                      || isAdmin());
      allow write: if false;
    }

    // ----- userPresence/{uid} -----------------------------------------------
    // "Somebody with the app is around here." One doc per user, holding their
    // last known coarse position, written by their own handset while the app is
    // open. It is what puts the red dots on the passenger home map.
    //
    // WRITE is owner-only and field-whitelisted, and follows the same reasoning
    // as drivers/{uid}: a location beacon that ran through a Cloud Function
    // would cost an invocation per ping for a decorative map layer.
    //
    // READ is owner + admin ONLY, deliberately. No user may query this
    // collection — anyone who could would have a live "where is everyone"
    // feed keyed by uid. The map layer goes through the getNearbyActivity
    // callable instead, which returns blurred, anonymous, un-attributable
    // points and never the underlying documents.
    //
    // Docs self-delete via a Firestore TTL policy on `expireAt` (see
    // docs/HARDENING.md), so a user who stops opening the app stops being on
    // anybody's map.
    match /userPresence/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'lat', 'lng', 'geohash', 'lastSeenAt', 'expireAt']);
      allow update: if isOwner(userId)
                    && onlyChanges(['lat', 'lng', 'geohash', 'lastSeenAt', 'expireAt']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ----- Catch-all DENY --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
