# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output (compiled TS lives in each package's own /lib, ignored there).
# Do NOT put a bare `lib/` here: it also matches source dirs like src/lib/.
dist/
build/
*.tsbuildinfo

# Next.js (admin app at repo root)
/.next/
/out/
next-env.d.ts
.vercel

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# Secrets / credentials — NEVER commit these
*serviceAccount*.json
service-account*.json
.env
.env.*
!.env.example
google-services.json
!apps/mobile/google-services.json
GoogleService-Info.plist
!apps/mobile/GoogleService-Info.plist

# Expo / React Native
.expo/
.expo-shared/
apps/mobile/ios/
apps/mobile/android/
# A prebuild run from the repo root drops a second native project here (~766 MB
# of generated Gradle output). Same rule as the app's own android/ — it is built,
# never authored.
/android/
*.keystore
*.jks

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log
coverage/

velocity-fe379-firebase-adminsdk-fbsvc-2efeecd69a.json
*.json.key
*-firebase-adminsdk-*.json

# Play bundles. The newest build is kept at the repo root so it is obvious which
# artifact is current, but these are ~90MB binaries and have no business in git
# history — one accidental `git add .` would bloat the repo permanently.
*.aab
*.apk
