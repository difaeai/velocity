rules_version = '2';

// ============================================================================
//  Velocity — Cloud Storage Security Rules
// ----------------------------------------------------------------------------
//  Default DENY. Auth required everywhere. Driver verification documents (CNIC,
//  licence, vehicle papers) are write-by-owner but READABLE ONLY by the backend
//  / admins — never by other users. Image uploads are size- and type-capped.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function underSize(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024;
    }

    // Public-ish profile avatars: world-readable, owner-writable, capped at 5MB.
    match /users/{userId}/avatar/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImage() && underSize(5);
    }

    // Sensitive KYC / vehicle documents: owner can upload, but only the owner
    // and admins can read them back. Never world-readable.
    match /drivers/{driverId}/documents/{fileName} {
      allow read: if isOwner(driverId) || isAdmin();
      allow write: if isOwner(driverId) && underSize(15);
    }

    // Payment screenshots proving a debt to Velocity was settled — cancellation
    // fees, owed by passengers and drivers alike (driver commission proofs still
    // go under drivers/{uid}/documents). Uploaded by the payer, read back only
    // by them and admins; the AI verifier reads via the Admin SDK.
    match /settlements/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImage() && underSize(15);
    }

    // Passenger CNIC photos — the identity gate in front of the courier flow.
    // Same posture as driver KYC: the owner uploads, only the owner and admins
    // can read them back. Never world-readable.
    match /cnic/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImage() && underSize(15);
    }

    // Pro Partner registration-fee receipts. The applicant uploads a screenshot
    // of the transfer; only they and the admin reviewing the application can
    // read it back. It carries their bank/wallet details, so it is never
    // world-readable — same posture as CNIC and driver KYC.
    match /partners/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) && isImage() && underSize(15);
    }

    // Avatars uploaded via Cloud Function (avatars/{uid}.jpg).
    // Admin SDK bypasses rules so only a read rule is needed here.
    match /avatars/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // TravelMate profile photos uploaded via Cloud Function (travelMatePhotos/{uid}.jpg).
    // Storage Rules cannot mix a wildcard and a literal suffix in one segment,
    // so we match the whole directory. Writes go through the Admin SDK only.
    match /travelMatePhotos/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // TravelMate community feed images — uploaded via the createTravelMatePost
    // Cloud Function (Admin SDK bypasses rules); readable by signed-in users
    // so feed cards render.
    match /travelMateFeedMedia/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // TravelMate community feed videos — too large for the base64 callable
    // path, so the owner uploads directly from the app (capped at 50 MB,
    // video/* only). createTravelMatePost then verifies the path prefix
    // belongs to the caller before attaching it to a post.
    match /travelMateFeedVideos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
                   && underSize(50)
                   && request.resource.contentType.matches('video/.*');
    }

    // TravelMate chat attachments — photos and documents shared in 1:1 / group
    // chats. The owner uploads directly from the app (capped at 25 MB); the
    // sendTravelMateMessage Cloud Function then verifies the URL belongs to our
    // bucket before attaching it to a message. Readable by signed-in users so
    // the other party can open the attachment.
    match /travelMateChat/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && underSize(25);
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
