# Firebase Web config (NOT secret — the Web API key only identifies the project;
# access is enforced by Firestore rules + App Check). Override per-environment.
# All client-exposed vars MUST be prefixed EXPO_PUBLIC_ to be inlined by Expo.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps Android key. THIS ONE IS BILLABLE — never commit a filled value.
# Set it here for local runs; for EAS builds use an EAS secret of the same name:
#   eas secret:create --scope project --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value <key>
# Protect it in Google Cloud Console with an Android app restriction + API
# restriction + quota cap (see backend/functions/.env.example for the rationale).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── AdMob ─────────────────────────────────────────────────────────────────────
# MASTER SWITCH. Anything other than the exact string "true" — including unset —
# means the app shows no ads at all: no SDK init, no requests, no placements.
# It is off by default on purpose. Ads make the account "monetised", which is
# what puts the "Contains ads" badge and the developer's full postal address on
# the public Play listing, so a build has to be able to prove it serves none.
# Keep this blank until the organisation account is in place; when you set it,
# flip Play Console → App content → Ads to "Yes" BEFORE rolling the build out.
EXPO_PUBLIC_ADS_ENABLED=
#
# None of the rest are secrets (an ad unit id is visible in every ad request), but
# they are env-driven so a debug build can never bill impressions to the real
# account. LEAVE THEM BLANK for local development: blank falls back to Google's
# test inventory, and test ads are the ONLY ads you may safely tap yourself.
# Clicking your own live ads is invalid traffic, which gets AdMob accounts
# limited or disabled.
#
# App IDs use a tilde and are baked into the manifest at build time. Take them
# from AdMob → Apps → App settings.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
#
# Ad unit IDs use a slash. Two units cover every placement — the banner is
# shared by Travel Partner, Earn and the "Where to?" sheet; the interstitial is
# shared by the discover-deck and post-application triggers.
# Take them from AdMob → Apps → Ad units.
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
#
# Devices served TEST ads even when the build carries live ad unit IDs — the
# only safe way to exercise the real configuration by hand, since tapping a
# genuine ad on your own device is invalid traffic. Run the app once and copy
# the hash the Google SDK prints in logcat ("setTestDeviceIds(...)").
# Comma-separated for several devices.
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
