<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- An in-app call keeps its microphone while the driver is in Google Maps or the screen is off. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <!-- An incoming call rings full-screen on a locked phone. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

  <application>
    <service
      android:name="expo.modules.velocitycalls.CallService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
    <receiver
      android:name="expo.modules.velocitycalls.DeclineReceiver"
      android:exported="false" />
  </application>
</manifest>
